# Copy to `.dev.vars` for local development. Never commit real secrets.

# Public site URL used for canonical URLs and CORS
PUBLIC_SITE_URL=http://localhost:4321

# Cloudflare Turnstile (create keys at https://dash.cloudflare.com/?to=/:account/turnstile)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Workers AI model (must be a currently supported Workers AI instruction model)
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Optional Cloudflare Web Analytics token
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Resend (https://resend.com) — emails new leads to info@chexustudio.com
# RESEND_API_KEY=re_xxxxxxxxx
# CONTACT_FROM_EMAIL=Che Xu Studio <info@chexustudio.com>
# CONTACT_NOTIFY_EMAIL=info@chexustudio.com

# Studio OS foundation (Phase 2+)
# Local `astro dev` always allows /admin. For `astro preview` / production Workers,
# set STUDIO_OS_ENABLED=true only on intentional staging. Never enable in production
# until Phase 5 authentication is ready. Do not use passwords or query-string bypasses.
# STUDIO_OS_ENABLED=true
