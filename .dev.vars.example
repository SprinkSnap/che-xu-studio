# Copy to `.dev.vars` for local development. Never commit real secrets.

# Public site URL used for canonical URLs and CORS
PUBLIC_SITE_URL=http://localhost:4321

# Cloudflare Turnstile (create keys at https://dash.cloudflare.com/?to=/:account/turnstile)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Workers AI model (must be a currently supported Workers AI instruction model)
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Optional Cloudflare Web Analytics token
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Resend (https://resend.com) — emails new leads to info@chexustudio.com
# RESEND_API_KEY=re_xxxxxxxxx
# CONTACT_FROM_EMAIL=Che Xu Studio <info@chexustudio.com>
# CONTACT_NOTIFY_EMAIL=info@chexustudio.com

# Studio OS foundation (Phase 2+)
# Local `astro dev` always allows /admin. For `astro preview` / production Workers,
# set STUDIO_OS_ENABLED=true. Phase 5 requires Supabase Auth + active profiles membership.
# Do not use passwords or query-string bypasses as authorization.
# STUDIO_OS_ENABLED=true

# Canonical Studio origin (password-reset redirects). Production:
# STUDIO_BASE_URL=https://studio.chexustudio.com
# Local default falls back to the request origin / http://localhost:4321

# Studio OS — Supabase (Phase 3+)
# Browser-safe (ok as Worker plain vars / PUBLIC_):
# PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only (Workers Builds → Encrypt secret). NEVER prefix with PUBLIC_:
# SUPABASE_SECRET_KEY=sb_secret_xxx
# Local CLI: npm run supabase:start && npm run supabase:status
# First owner: see docs/architecture/studio-auth.md (dashboard SQL or bootstrap script)
# See docs/architecture/supabase.md and docs/architecture/studio-auth.md

# Studio OS — Stripe (Phase 11+)
# Publishable key may be exposed to the browser if needed:
# PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Server-only (Workers Builds → Encrypt secret). NEVER prefix with PUBLIC_:
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Webhook endpoint: POST /api/webhooks/stripe
# Local Stripe CLI: stripe listen --forward-to localhost:4321/api/webhooks/stripe
# See docs/architecture/payments.md
