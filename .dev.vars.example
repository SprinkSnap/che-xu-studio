# Copy to `.dev.vars` for local development. Never commit real secrets.

# Public site URL used for canonical URLs and CORS
PUBLIC_SITE_URL=http://localhost:4321

# Cloudflare Turnstile (create keys at https://dash.cloudflare.com/?to=/:account/turnstile)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Workers AI model (must be a currently supported Workers AI instruction model)
AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Optional Cloudflare Web Analytics token
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
