{
  "name": "che-xu-studio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for Che Xu Studio — high-converting web design, SEO strategy, and website care.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prepare-cf-deploy.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply che-xu-studio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply che-xu-studio-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.6",
    "lucide-react": "^1.27.0",
    "nanoid": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.4.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.115.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~5.8.3",
    "vitest": "^4.1.10"
  }
}
