---
import { siteConfig } from '../config/site';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
const socialEntries = Object.entries(siteConfig.social).filter(([, href]) =>
  Boolean(href),
) as Array<[string, string]>;
---

<footer class="border-t border-navy-800 bg-navy-950 text-blue-100">
  <div class="container-shell section !pb-10 !pt-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4 sm:col-span-2 lg:col-span-1">
        <Wordmark variant="light" />
        <p class="max-w-sm text-sm leading-relaxed text-blue-100/80">
          {siteConfig.tagline}
        </p>
        <p class="text-sm font-medium text-white">{siteConfig.supportingMessage}</p>
        {
          (siteConfig.contact.email || siteConfig.contact.phone || socialEntries.length > 0) && (
            <div class="space-y-1 text-sm">
              {siteConfig.contact.email && (
                <p>
                  <a class="hover:text-white" href={`mailto:${siteConfig.contact.email}`}>
                    {siteConfig.contact.email}
                  </a>
                </p>
              )}
              {siteConfig.contact.phone && (
                <p>
                  <a class="hover:text-white" href={`tel:${siteConfig.contact.phone}`}>
                    {siteConfig.contact.phoneDisplay || siteConfig.contact.phone}
                  </a>
                </p>
              )}
              {socialEntries.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-3">
                  {socialEntries.map(([network, href]) => (
                    <li>
                      <a class="hover:text-white" href={href} rel="noopener noreferrer">
                        {network}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )
        }
      </div>

      <div>
        <h2 class="mb-4 font-sans text-sm font-semibold uppercase tracking-[0.14em] text-white">
          Services
        </h2>
        <ul class="space-y-2 text-sm">
          {
            siteConfig.footer.services.map((link) => (
              <li>
                <a class="inline-flex min-h-11 items-center hover:text-white" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mb-4 font-sans text-sm font-semibold uppercase tracking-[0.14em] text-white">
          Studio
        </h2>
        <ul class="space-y-2 text-sm">
          {
            siteConfig.footer.studio.map((link) => (
              <li>
                <a class="inline-flex min-h-11 items-center hover:text-white" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mb-4 font-sans text-sm font-semibold uppercase tracking-[0.14em] text-white">
          Legal
        </h2>
        <ul class="space-y-2 text-sm">
          {
            siteConfig.footer.legal.map((link) => (
              <li>
                <a class="inline-flex min-h-11 items-center hover:text-white" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-blue-100/70 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {siteConfig.legalName}. All rights reserved.</p>
      <p>Prices shown in CAD. “Starting at” prices are confirmed after scope review.</p>
    </div>
  </div>
</footer>
