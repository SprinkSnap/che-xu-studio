---
import { siteConfig } from '../config/site';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
const socialEntries = Object.entries(siteConfig.social).filter(([, href]) =>
  Boolean(href),
) as Array<[string, string]>;
const trustPills = siteConfig.trustStrip.split('·').map((item) => item.trim());

function footerLinkTrack(section: string, label: string): string {
  const safeSection = section.replace(/'/g, "\\'");
  const safeLabel = label.replace(/'/g, "\\'");
  return `window.__cxTrack && window.__cxTrack({ event: 'footer_link_clicked', props: { section: '${safeSection}', label: '${safeLabel}' } })`;
}
---

<footer class="footer-shell border-t border-navy-800 text-blue-100" aria-label="Site footer">
  <div class="container-shell !pb-8 !pt-12 sm:!pb-10 sm:!pt-16 lg:!pt-20">
    <section class="footer-cta-panel mb-10 sm:mb-12 lg:mb-14" aria-labelledby="footer-cta-heading">
      <div
        class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-brand-bright/20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-20 -left-12 h-40 w-40 rounded-full bg-purple-500/15 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-center lg:gap-10 xl:gap-14">
        <div class="max-w-2xl">
          <p class="eyebrow !text-blue-300">{siteConfig.footer.cta.eyebrow}</p>
          <h2
            id="footer-cta-heading"
            class="mt-3 font-display text-2xl font-bold leading-tight text-white sm:text-3xl lg:text-[2rem] xl:text-4xl"
          >
            {siteConfig.footer.cta.headline}
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-blue-100/85 sm:text-base lg:mt-4 lg:text-lg">
            {siteConfig.footer.cta.body}
          </p>
        </div>

        <div class="flex flex-col gap-4 lg:items-stretch">
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
            <a
              href={siteConfig.cta.primary.href}
              class="btn btn-primary-on-dark w-full sm:flex-1 lg:w-full xl:flex-1"
              data-track="footer_cta_quote"
              onclick="window.__cxTrack && window.__cxTrack({ event: 'service_cta_selected', props: { cta: 'quote', source: 'footer' } })"
            >
              {siteConfig.cta.primary.label}
            </a>
            <a
              href={siteConfig.cta.secondary.href}
              class="btn-secondary w-full border-white/20 bg-white/10 text-white hover:border-white/30 hover:bg-white/15 sm:flex-1 lg:w-full xl:flex-1"
              data-track="footer_cta_finder"
              onclick="window.__cxTrack && window.__cxTrack({ event: 'service_cta_selected', props: { cta: 'finder', source: 'footer' } })"
            >
              {siteConfig.cta.secondary.label}
            </a>
          </div>
          <p class="text-center text-xs text-blue-100/70 lg:text-left">
            {siteConfig.footer.cta.reassurance}
          </p>
          <ul class="flex flex-wrap justify-center gap-2 lg:justify-start" aria-label="Studio trust highlights">
            {
              trustPills.map((pill) => (
                <li>
                  <span class="footer-trust-pill">{pill}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <div class="grid gap-10 md:grid-cols-3 md:gap-8 lg:gap-12">
      <div class="space-y-5">
        <div class="footer-brand-box">
          <Wordmark variant="light" withTagline />
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-blue-100/80">{siteConfig.supportingMessage}</p>
        <div class="flex flex-wrap items-center gap-2">
          <span class="footer-locale-badge">Serving Canada · {siteConfig.currency}</span>
        </div>
        {
          (siteConfig.contact.email || siteConfig.contact.phone || socialEntries.length > 0) && (
            <address class="space-y-3 text-sm not-italic">
              {siteConfig.contact.email && (
                <p>
                  <a
                    class="footer-contact-chip"
                    href={`mailto:${siteConfig.contact.email}`}
                    onclick={footerLinkTrack('contact', 'email')}
                  >
                    {siteConfig.contact.email}
                  </a>
                </p>
              )}
              {siteConfig.contact.phone && (
                <p>
                  <a
                    class="footer-contact-chip"
                    href={`tel:${siteConfig.contact.phone}`}
                    onclick={footerLinkTrack('contact', 'phone')}
                  >
                    {siteConfig.contact.phoneDisplay || siteConfig.contact.phone}
                  </a>
                </p>
              )}
              {socialEntries.length > 0 && (
                <ul class="flex flex-wrap gap-2 pt-1">
                  {socialEntries.map(([network, href]) => (
                    <li>
                      <a
                        class="footer-trust-pill capitalize transition hover:border-white/25 hover:bg-white/10 hover:text-white"
                        href={href}
                        rel="noopener noreferrer"
                        onclick={footerLinkTrack('social', network)}
                      >
                        {network}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </address>
          )
        }
      </div>

      <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-1">
        <nav aria-labelledby="footer-services-heading">
          <h2
            id="footer-services-heading"
            class="mb-2 font-sans text-sm font-semibold uppercase tracking-[0.14em] text-white"
          >
            Services
          </h2>
          <p class="mb-4 text-xs leading-relaxed text-blue-100/65">
            {siteConfig.footer.columnDescriptions.services}
          </p>
          <ul class="space-y-1 text-sm">
            {
              siteConfig.footer.services.map((link) => (
                <li>
                  <a
                    class="footer-link"
                    href={link.href}
                    title={link.description}
                    aria-label={link.label}
                    onclick={footerLinkTrack('services', link.label)}
                  >
                    <span class="footer-link-label">{link.label}</span>
                    {link.description && (
                      <span class="mt-0.5 hidden text-xs leading-snug text-blue-100/55 md:block">
                        {link.description}
                      </span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="footer-studio-heading">
          <h2
            id="footer-studio-heading"
            class="mb-2 font-sans text-sm font-semibold uppercase tracking-[0.14em] text-white"
          >
            Studio
          </h2>
          <p class="mb-4 text-xs leading-relaxed text-blue-100/65">
            {siteConfig.footer.columnDescriptions.studio}
          </p>
          <ul class="space-y-1 text-sm">
            {
              siteConfig.footer.studio.map((link) => (
                <li>
                  <a
                    class:list={[
                      'footer-link',
                      link.href === '/contact' &&
                        '!mx-0 rounded-[var(--radius-md)] border border-white/10 bg-white/[0.05] px-3 py-2 hover:border-white/20 hover:bg-white/10',
                    ]}
                    href={link.href}
                    title={link.description}
                    aria-label={link.label}
                    onclick={footerLinkTrack('studio', link.label)}
                  >
                    <span class="footer-link-label">{link.label}</span>
                    {link.description && (
                      <span class="mt-0.5 hidden text-xs leading-snug text-blue-100/55 md:block">
                        {link.description}
                      </span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <nav aria-labelledby="footer-legal-heading">
        <h2
          id="footer-legal-heading"
          class="mb-2 font-sans text-sm font-semibold uppercase tracking-[0.14em] text-white"
        >
          Legal
        </h2>
        <p class="mb-4 text-xs leading-relaxed text-blue-100/65">
          {siteConfig.footer.columnDescriptions.legal}
        </p>
        <ul class="space-y-1 text-sm">
          {
            siteConfig.footer.legal.map((link) => (
              <li>
                <a
                  class="footer-link"
                  href={link.href}
                  title={link.description}
                  aria-label={link.label}
                  onclick={footerLinkTrack('legal', link.label)}
                >
                  <span class="footer-link-label">{link.label}</span>
                  {link.description && (
                    <span class="mt-0.5 hidden text-xs leading-snug text-blue-100/55 md:block">
                      {link.description}
                    </span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-blue-100/70 sm:mt-12 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {siteConfig.legalName}. All rights reserved.</p>
      <p class="max-w-xl sm:text-right">
        Prices shown in CAD. “Starting at” prices are confirmed after scope review.
      </p>
    </div>
  </div>
</footer>
