---
import { siteConfig } from '../config/site';
import Wordmark from './Wordmark.astro';
import MobileNav from './react/MobileNav';
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-navy-950/90 text-white backdrop-blur-md"
>
  <div class="container-shell flex h-[var(--header-height)] items-center justify-between gap-4">
    <Wordmark variant="light" />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        siteConfig.navigation.map((item) =>
          'children' in item && item.children ? (
            <div class="group relative">
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-blue-100 transition hover:bg-white/10 hover:text-white"
              >
                {item.label}
              </a>
              <div class="invisible absolute left-0 top-full z-50 min-w-56 translate-y-1 rounded-[var(--radius-md)] border border-white/10 bg-navy-900 p-2 opacity-0 shadow-lift transition group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block rounded-md px-3 py-2.5 text-sm text-blue-100 hover:bg-white/10 hover:text-white"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-blue-100 transition hover:bg-white/10 hover:text-white"
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a href={siteConfig.cta.secondary.href} class="btn-ghost">
        {siteConfig.cta.secondary.label}
      </a>
      <a href={siteConfig.cta.primary.href} class="btn btn-primary-on-dark" data-track="nav_primary_cta">
        {siteConfig.cta.primary.label}
      </a>
    </div>

    <MobileNav
      client:load
      items={siteConfig.navigation}
      primaryCta={siteConfig.cta.primary}
      secondaryCta={siteConfig.cta.secondary}
    />
  </div>
</header>
