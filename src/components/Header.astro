---
import { siteConfig } from '../config/site';
import Wordmark from './Wordmark.astro';
import PrimaryNav from './react/PrimaryNav';
import MobileNav from './react/MobileNav';

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-navy-950/90 text-white backdrop-blur-md"
>
  <div
    class="container-shell flex h-[var(--header-height)] items-center justify-between gap-3 sm:gap-4"
  >
    <Wordmark variant="light" />

    <PrimaryNav client:load items={siteConfig.navigation} currentPath={currentPath} />

    <div class="hidden items-center gap-2 lg:flex">
      <a href={siteConfig.cta.secondary.href} class="btn-ghost">
        {siteConfig.cta.secondary.label}
      </a>
      <a
        href={siteConfig.cta.primary.href}
        class="btn btn-primary-on-dark"
        data-track="nav_primary_cta"
        onclick="window.__cxTrack && window.__cxTrack({ event: 'service_cta_selected', props: { cta: 'quote', source: 'header' } })"
      >
        {siteConfig.cta.primary.label}
      </a>
    </div>

    <MobileNav client:load items={siteConfig.navigation} currentPath={currentPath} />
  </div>
</header>
