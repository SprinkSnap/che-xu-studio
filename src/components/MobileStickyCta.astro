---
import { siteConfig } from '../config/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-border bg-white/95 p-3 shadow-[0_-8px_30px_-18px_rgb(6_16_31_/_0.35)] backdrop-blur md:hidden"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
>
  <div class="mx-auto flex max-w-lg gap-2">
    <a
      href={siteConfig.cta.primary.href}
      class="btn-primary flex-1 text-center"
      data-track="mobile_sticky_finder"
    >
      Find My Package
    </a>
    <a href="/contact" class="btn-secondary flex-1 text-center" data-track="mobile_sticky_contact">
      Talk to us
    </a>
  </div>
</div>
