---
const outcomes = [
  {
    title: 'Get found by the right people',
    body: 'Search-friendly structure, clear service messaging, and technical foundations that help Canadian customers discover your business.',
    accent: 'green',
  },
  {
    title: 'Win more qualified enquiries',
    body: 'Conversion-focused layouts, frictionless contact paths, and offers presented so visitors know what to do next.',
    accent: 'blue',
  },
  {
    title: 'Stay fast, secure, and online',
    body: 'Performance-minded builds plus optional website care for updates, backups, monitoring, and priority support.',
    accent: 'gold',
  },
];
---

<section class="section">
  <div class="container-shell">
    <div class="max-w-2xl">
      <p class="eyebrow mb-3">Outcomes</p>
      <h2 class="font-display text-3xl font-bold text-navy-900 sm:text-4xl">
        Built to turn attention into action
      </h2>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        outcomes.map((item) => (
          <article class={`accent-${item.accent} rounded-[var(--radius-lg)] border border-border bg-white p-6 shadow-soft`}>
            <div
              class="mb-4 h-1.5 w-12 rounded-full bg-[var(--accent)]"
              aria-hidden="true"
            />
            <h3 class="font-display text-2xl font-bold text-navy-900">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
