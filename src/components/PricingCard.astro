---
import { quoteContactHref, type ServicePackage } from '../config/packages';

interface Props {
  pkg: ServicePackage;
  featured?: boolean;
  showCta?: boolean;
}

const { pkg, featured = pkg.popular, showCta = true } = Astro.props;
const accentClass = `accent-${pkg.accent}`;
const quoteHref = quoteContactHref(pkg.id);
---

<article
  id={pkg.id}
  class:list={[
    'surface-card relative flex h-full flex-col overflow-hidden p-6 sm:p-7',
    accentClass,
    featured && 'ring-2 ring-[var(--accent)]',
  ]}
  data-package-id={pkg.id}
>
  {
    pkg.popular && (
      <p class="absolute right-4 top-4 rounded-md bg-[var(--accent)] px-2.5 py-1 text-xs font-semibold text-white">
        Most Popular
      </p>
    )
  }

  <div class="mb-5">
    <p class="text-sm font-semibold uppercase tracking-[0.12em] text-[var(--accent)]">
      {pkg.category === 'web-design'
        ? 'Web Design'
        : pkg.category === 'seo'
          ? 'SEO'
          : 'Website Care'}
    </p>
    <h3 class="mt-2 font-display text-2xl font-bold text-navy-900">{pkg.name}</h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-muted">{pkg.summary}</p>
  </div>

  <div class="mb-5 border-y border-border py-4">
    <p class="text-sm text-ink-muted">Starting at</p>
    <p class="mt-1 font-display text-4xl font-bold text-navy-900">
      {pkg.priceLabel}
      {pkg.priceSuffix && (
        <span class="text-lg font-semibold text-ink-muted">{pkg.priceSuffix}</span>
      )}
    </p>
    {pkg.timeline && <p class="mt-2 text-sm font-medium text-navy-700">Timeline: {pkg.timeline}</p>}
  </div>

  <ul class="mb-6 flex-1 space-y-2.5 text-sm text-ink">
    {
      pkg.includes.map((item) => (
        <li class="flex gap-2">
          <span
            class="mt-1 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] text-[var(--accent)]"
            aria-hidden="true"
          >
            <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  <div class="space-y-2 text-xs leading-relaxed text-ink-muted">
    {pkg.disclosures.map((d) => <p>{d}</p>)}
  </div>

  {
    showCta && (
      <div class="mt-6 flex flex-col gap-2">
        <a
          href={quoteHref}
          class="btn-primary w-full text-center"
          data-track="pricing_card_selected"
          data-track-prop={pkg.id}
        >
          {pkg.billing === 'monthly' ? 'Request this plan' : 'Get a quote'}
        </a>
        <a href={pkg.serviceHref} class="btn-secondary w-full text-center">
          Learn about this service
        </a>
      </div>
    )
  }
</article>
