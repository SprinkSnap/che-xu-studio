---
import { siteConfig } from '../config/site';

interface Props {
  /** `light` = logo for dark backgrounds; `dark` = logo for light backgrounds */
  variant?: 'light' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  /** Include the tagline lockup (footer / brand blocks). Default is name mark only. */
  withTagline?: boolean;
}

const { variant = 'dark', size = 'md', withTagline = false } = Astro.props;

const onDark = variant === 'light';
const src = withTagline
  ? onDark
    ? '/logo-lockup-on-dark.png'
    : '/logo-lockup.png'
  : onDark
    ? '/logo-on-dark.png'
    : '/logo.png';

const heightClass = withTagline
  ? size === 'lg'
    ? 'h-16 sm:h-20'
    : size === 'sm'
      ? 'h-12'
      : 'h-14 sm:h-16'
  : size === 'lg'
    ? 'h-10 sm:h-12'
    : size === 'sm'
      ? 'h-7'
      : 'h-8 sm:h-9';

const maxWidthClass = withTagline
  ? 'max-w-[min(100%,20rem)] sm:max-w-[min(100%,24rem)]'
  : 'max-w-[min(100%,12.5rem)] sm:max-w-[min(100%,16rem)] md:max-w-none';
---

<a
  href="/"
  class="group inline-flex items-center"
  aria-label={`${siteConfig.name} home`}
>
  <img
    src={src}
    alt=""
    width={withTagline ? 1706 : 1370}
    height={withTagline ? 360 : 191}
    class:list={[
      'w-auto object-contain object-left transition duration-200 group-hover:opacity-90',
      heightClass,
      maxWidthClass,
    ]}
    decoding="async"
  />
</a>
