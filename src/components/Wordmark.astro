---
import { siteConfig } from '../config/site';

interface Props {
  /** `light` = logo for dark backgrounds; `dark` = logo for light backgrounds */
  variant?: 'light' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  /** Larger brand lockup (footer / brand blocks). Default is header mark size. */
  withTagline?: boolean;
}

const { size = 'md', withTagline = false } = Astro.props;

// Single brand master (light artwork on transparent). Prefer dark surfaces.
// `variant` remains accepted for callers; artwork is optimized for dark UI chrome.
const src = '/che-xu-studio-web-design-seo-logo.png';

const heightClass = withTagline
  ? size === 'lg'
    ? 'h-16 sm:h-20'
    : size === 'sm'
      ? 'h-12'
      : 'h-14 sm:h-16'
  : size === 'lg'
    ? 'h-10 sm:h-12'
    : size === 'sm'
      ? 'h-7'
      : 'h-8 sm:h-9';

const maxWidthClass = withTagline
  ? 'max-w-[min(100%,20rem)] sm:max-w-[min(100%,24rem)]'
  : 'max-w-[min(100%,12.5rem)] sm:max-w-[min(100%,16rem)] md:max-w-none';
---

<a
  href="/"
  class="group inline-flex items-center"
  aria-label={`${siteConfig.name} home`}
>
  <img
    src={src}
    alt=""
    width={1433}
    height={368}
    class:list={[
      'w-auto object-contain object-left transition duration-200 group-hover:opacity-90',
      heightClass,
      maxWidthClass,
    ]}
    decoding="async"
  />
</a>
