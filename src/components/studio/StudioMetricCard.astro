---
interface Props {
  label: string;
  value?: string;
  hint?: string | null;
  href?: string | null;
}

const { label, value = '—', hint = null, href = null } = Astro.props;
---

{
  href ? (
    <a class="studio-metric-card studio-metric-card-link" href={href}>
      <p class="studio-metric-label">{label}</p>
      <p class="studio-metric-value">{value}</p>
      {hint && <p class="studio-metric-hint">{hint}</p>}
    </a>
  ) : (
    <div class="studio-metric-card">
      <p class="studio-metric-label">{label}</p>
      <p class="studio-metric-value">{value}</p>
      {hint && <p class="studio-metric-hint">{hint}</p>}
    </div>
  )
}
