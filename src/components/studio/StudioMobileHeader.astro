---
interface Props {
  title?: string;
}

const { title = 'Studio OS' } = Astro.props;
---

<header class="studio-mobile-header">
  <div class="flex min-w-0 items-center gap-3">
    <button
      type="button"
      class="studio-action"
      data-studio-nav-open
      aria-expanded="false"
      aria-controls="studio-mobile-drawer"
    >
      Menu
    </button>
    <div class="min-w-0">
      <p class="truncate text-sm font-semibold text-navy-900">{title}</p>
      <p class="truncate text-xs text-ink-muted">Che Xu Studio</p>
    </div>
  </div>
  <a href="/admin" class="text-sm font-semibold text-brand">Dashboard</a>
</header>
