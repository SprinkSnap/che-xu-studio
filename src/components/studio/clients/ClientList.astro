---
import StudioStatusBadge from '../StudioStatusBadge.astro';
import { formatMoney, formatStudioDate } from '../../../lib/clients/format';
import type { ClientListItem } from '../../../lib/clients/types';

interface Props {
  items: ClientListItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <>
      <div class="studio-table-wrap hidden lg:block">
        <table class="studio-table">
          <thead>
            <tr>
              <th scope="col">Client</th>
              <th scope="col">Primary contact</th>
              <th scope="col">Email</th>
              <th scope="col">Active projects</th>
              <th scope="col">Outstanding</th>
              <th scope="col">Lifetime revenue</th>
              <th scope="col">Status</th>
              <th scope="col">Updated</th>
            </tr>
          </thead>
          <tbody>
            {items.map((item) => (
              <tr class="studio-table-row">
                <td>
                  <a class="studio-client-link" href={`/admin/clients/${item.id}`}>
                    {item.displayName || item.companyName}
                  </a>
                  {item.displayName && item.displayName !== item.companyName && (
                    <p class="text-xs text-ink-muted mt-0.5">{item.companyName}</p>
                  )}
                </td>
                <td>{item.primaryContactName || '—'}</td>
                <td>{item.primaryContactEmail || item.billingEmail || '—'}</td>
                <td>{item.activeProjectsCount}</td>
                <td>{formatMoney(item.outstandingBalanceMinor)}</td>
                <td>{formatMoney(item.lifetimePaidMinor)}</td>
                <td>
                  <StudioStatusBadge
                    label={item.status === 'active' ? 'Active' : 'Archived'}
                    tone={item.status === 'active' ? 'success' : 'neutral'}
                  />
                </td>
                <td>{formatStudioDate(item.updatedAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="studio-client-mobile-list lg:hidden" role="list">
        {items.map((item) => (
          <li>
            <a class="studio-client-mobile-card" href={`/admin/clients/${item.id}`}>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="studio-client-mobile-name">{item.displayName || item.companyName}</p>
                  <p class="text-sm text-ink-muted mt-1">
                    {item.primaryContactName || item.primaryContactEmail || item.billingEmail || 'No contact'}
                  </p>
                </div>
                <StudioStatusBadge
                  label={item.status === 'active' ? 'Active' : 'Archived'}
                  tone={item.status === 'active' ? 'success' : 'neutral'}
                />
              </div>
              {(item.outstandingBalanceMinor > 0 || item.lifetimePaidMinor > 0) && (
                <p class="mt-3 text-sm text-ink-muted">
                  Outstanding {formatMoney(item.outstandingBalanceMinor)}
                  <span class="mx-2" aria-hidden="true">
                    ·
                  </span>
                  Lifetime {formatMoney(item.lifetimePaidMinor)}
                </p>
              )}
            </a>
          </li>
        ))}
      </ul>
    </>
  )
}
