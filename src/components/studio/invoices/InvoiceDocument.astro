---
import { formatMoney, formatDateOnly } from '../../../lib/clients/format';
import { formatScaledQuantity } from '../../../lib/finance/calculations';
import { bpsToPercentInput } from '../../../lib/money/parse';
import type { CurrencyCode } from '../../../lib/supabase/domain';
import type { InvoiceItemRow } from '../../../lib/invoices/types';

interface Props {
  invoiceNumber: string;
  invoiceTypeLabel: string;
  statusLabel: string;
  clientDisplayName: string;
  clientContactName: string | null;
  clientContactEmail: string | null;
  clientBillingAddress: string | null;
  projectName: string | null;
  studioBusinessName: string | null;
  studioBillingEmail: string | null;
  studioBusinessAddress: string | null;
  issueDate: string | null;
  dueDate: string | null;
  items: InvoiceItemRow[];
  subtotalMinor: number;
  discountMinor: number;
  taxMinor: number;
  taxBps: number;
  totalMinor: number;
  amountPaidMinor: number;
  balanceDueMinor: number;
  currency: CurrencyCode;
  paymentInstructions: string | null;
  showPaymentPlaceholder?: boolean;
}

const {
  invoiceNumber,
  invoiceTypeLabel,
  statusLabel,
  clientDisplayName,
  clientContactName,
  clientContactEmail,
  clientBillingAddress,
  projectName,
  studioBusinessName,
  studioBillingEmail,
  studioBusinessAddress,
  issueDate,
  dueDate,
  items,
  subtotalMinor,
  discountMinor,
  taxMinor,
  taxBps,
  totalMinor,
  amountPaidMinor,
  balanceDueMinor,
  currency,
  paymentInstructions,
  showPaymentPlaceholder = true,
} = Astro.props;

const taxPercent = bpsToPercentInput(taxBps);

function quantityLabel(quantity: number): string {
  const scaled = Math.round(Number(quantity) * 10_000);
  return formatScaledQuantity(scaled);
}
---

<div class="studio-invoice-doc">
  <div class="mb-10 flex flex-col gap-6 sm:flex-row sm:justify-between">
    <div>
      {
        studioBusinessName && (
          <p class="font-display text-2xl font-semibold text-navy-900">{studioBusinessName}</p>
        )
      }
      {
        studioBusinessAddress && (
          <p class="mt-2 whitespace-pre-line text-sm text-ink-muted">{studioBusinessAddress}</p>
        )
      }
      {
        studioBillingEmail && (
          <p class="mt-1 text-sm text-ink-muted">{studioBillingEmail}</p>
        )
      }
    </div>
    <div class="sm:text-right">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand">Invoice</p>
      <p class="mt-2 font-display text-2xl font-semibold text-navy-900">{invoiceNumber}</p>
      <p class="mt-2 text-sm text-ink-muted">{invoiceTypeLabel} · {statusLabel}</p>
      <dl class="mt-4 space-y-1 text-sm">
        <div class="flex gap-3 sm:justify-end">
          <dt class="text-ink-muted">Issue date</dt>
          <dd class="tabular-nums text-navy-900">{formatDateOnly(issueDate)}</dd>
        </div>
        <div class="flex gap-3 sm:justify-end">
          <dt class="text-ink-muted">Due date</dt>
          <dd class="tabular-nums text-navy-900">{formatDateOnly(dueDate)}</dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="mb-10 grid gap-6 sm:grid-cols-2">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">Bill to</p>
      <p class="mt-2 text-base font-medium text-navy-900">{clientDisplayName}</p>
      {clientContactName && <p class="mt-1 text-sm text-ink-muted">{clientContactName}</p>}
      {clientContactEmail && <p class="text-sm text-ink-muted">{clientContactEmail}</p>}
      {
        clientBillingAddress && (
          <p class="mt-2 whitespace-pre-line text-sm text-ink-muted">{clientBillingAddress}</p>
        )
      }
    </div>
    {
      projectName && (
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">Project</p>
          <p class="mt-2 text-base text-navy-900">{projectName}</p>
        </div>
      )
    }
  </div>

  <div class="studio-table-wrap mb-8">
    <table class="studio-table studio-doc-table">
      <thead>
        <tr>
          <th scope="col">Description</th>
          <th scope="col" class="text-right">
            Qty
          </th>
          <th scope="col" class="text-right">
            Rate
          </th>
          <th scope="col" class="text-right">
            Amount
          </th>
        </tr>
      </thead>
      <tbody>
        {
          items.map((item) => (
            <tr>
              <td>{item.description}</td>
              <td class="tabular-nums text-right">{quantityLabel(item.quantity)}</td>
              <td class="tabular-nums text-right">
                {formatMoney(item.rate_minor, currency)}
              </td>
              <td class="tabular-nums text-right">
                {formatMoney(item.amount_minor, currency)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="ml-auto max-w-sm space-y-2 text-sm">
    <div class="flex justify-between gap-6 border-b border-border/70 py-2">
      <span class="text-ink-muted">Subtotal</span>
      <span class="tabular-nums text-navy-900">{formatMoney(subtotalMinor, currency)}</span>
    </div>
    {
      discountMinor > 0 && (
        <div class="flex justify-between gap-6 border-b border-border/70 py-2">
          <span class="text-ink-muted">Discount</span>
          <span class="tabular-nums text-navy-900">
            −{formatMoney(discountMinor, currency)}
          </span>
        </div>
      )
    }
    <div class="flex justify-between gap-6 border-b border-border/70 py-2">
      <span class="text-ink-muted">Tax ({taxPercent}%)</span>
      <span class="tabular-nums text-navy-900">{formatMoney(taxMinor, currency)}</span>
    </div>
    <div class="flex justify-between gap-6 py-3">
      <span class="font-medium text-navy-900">Total</span>
      <span class="font-display text-lg font-semibold tabular-nums text-navy-900">
        {formatMoney(totalMinor, currency)}
      </span>
    </div>
    <div class="flex justify-between gap-6 border-t border-border py-2">
      <span class="text-ink-muted">Amount paid</span>
      <span class="tabular-nums text-navy-900">{formatMoney(amountPaidMinor, currency)}</span>
    </div>
    <div class="flex justify-between gap-6 py-2">
      <span class="font-medium text-navy-900">Balance due</span>
      <span class="font-medium tabular-nums text-navy-900">
        {formatMoney(balanceDueMinor, currency)}
      </span>
    </div>
  </div>

  {
    paymentInstructions && (
      <section class="mt-10 border-t border-border pt-6">
        <h2 class="font-display text-lg font-semibold text-navy-900">Payment instructions</h2>
        <p class="mt-3 whitespace-pre-line text-sm text-ink-muted">{paymentInstructions}</p>
      </section>
    )
  }

  {
    showPaymentPlaceholder && (
      <section class="studio-doc-no-print mt-8 rounded-[var(--radius-md)] border border-dashed border-border px-4 py-3 text-sm text-ink-muted">
        Online payment is available on the secure client invoice link when this invoice has a
        positive balance.
      </section>
    )
  }
</div>
