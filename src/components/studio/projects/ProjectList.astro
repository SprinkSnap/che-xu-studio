---
import StudioStatusBadge from '../StudioStatusBadge.astro';
import { formatMoney, formatDateOnly, formatStudioDate } from '../../../lib/clients/format';
import {
  PROJECT_STATUS_LABELS,
  projectStatusTone,
} from '../../../lib/projects/workflow';
import type { ProjectListItem } from '../../../lib/projects/types';

interface Props {
  items: ProjectListItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <>
      <div class="studio-table-wrap hidden lg:block">
        <table class="studio-table">
          <thead>
            <tr>
              <th scope="col">Project</th>
              <th scope="col">Client</th>
              <th scope="col">Project type</th>
              <th scope="col">Status</th>
              <th scope="col">Project value</th>
              <th scope="col">Target date</th>
              <th scope="col">Updated</th>
            </tr>
          </thead>
          <tbody>
            {items.map((item) => (
              <tr class="studio-table-row">
                <td>
                  <a class="studio-client-link" href={`/admin/projects/${item.id}`}>
                    {item.name}
                  </a>
                </td>
                <td>
                  <a class="text-sm text-ink-muted hover:text-brand" href={`/admin/clients/${item.clientId}`}>
                    {item.clientName}
                  </a>
                </td>
                <td>{item.projectType || '—'}</td>
                <td>
                  <StudioStatusBadge
                    label={PROJECT_STATUS_LABELS[item.status]}
                    tone={projectStatusTone(item.status)}
                  />
                </td>
                <td class="tabular-nums text-right">
                  {formatMoney(item.projectPriceMinor, item.currency)}
                </td>
                <td>{formatDateOnly(item.targetCompletionDate)}</td>
                <td>{formatStudioDate(item.updatedAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="studio-client-mobile-list lg:hidden" role="list">
        {items.map((item) => (
          <li>
            <a class="studio-client-mobile-card" href={`/admin/projects/${item.id}`}>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="studio-client-mobile-name">{item.name}</p>
                  <p class="mt-1 text-sm text-ink-muted">{item.clientName}</p>
                </div>
                <StudioStatusBadge
                  label={PROJECT_STATUS_LABELS[item.status]}
                  tone={projectStatusTone(item.status)}
                />
              </div>
              <p class="mt-3 text-sm text-ink-muted">
                <span class="tabular-nums text-navy-900">
                  {formatMoney(item.projectPriceMinor, item.currency)}
                </span>
                <span class="mx-2" aria-hidden="true">
                  ·
                </span>
                Target {formatDateOnly(item.targetCompletionDate)}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </>
  )
}
