---
import { formatMoney, formatDateOnly } from '../../../lib/clients/format';
import { formatScaledQuantity } from '../../../lib/finance/calculations';
import type { CurrencyCode } from '../../../lib/supabase/domain';
import type { ProposalItemRow } from '../../../lib/proposals/types';

interface Props {
  proposalNumber: string;
  versionNumber: number;
  title: string;
  clientDisplayName: string;
  projectName: string;
  introduction: string | null;
  projectOverview: string | null;
  objectives: string | null;
  scope: string | null;
  deliverables: string | null;
  timeline: string | null;
  paymentSchedule: string | null;
  termsAndConditions: string | null;
  notes: string | null;
  items: ProposalItemRow[];
  subtotalMinor: number;
  discountMinor: number;
  taxMinor: number;
  totalMinor: number;
  taxBps: number;
  currency: CurrencyCode;
  expiresAt: string | null;
  isImmutable?: boolean;
  finalizedAt?: string | null;
}

const {
  proposalNumber,
  versionNumber,
  title,
  clientDisplayName,
  projectName,
  introduction,
  projectOverview,
  objectives,
  scope,
  deliverables,
  timeline,
  paymentSchedule,
  termsAndConditions,
  notes,
  items,
  subtotalMinor,
  discountMinor,
  taxMinor,
  totalMinor,
  taxBps,
  currency,
  expiresAt,
  isImmutable = false,
  finalizedAt = null,
} = Astro.props;

const taxPercent = (taxBps / 100).toFixed(taxBps % 100 === 0 ? 0 : 2);

function section(label: string, body: string | null | undefined) {
  return { label, body: body?.trim() || '' };
}

const sections = [
  section('Introduction', introduction),
  section('Project overview', projectOverview),
  section('Objectives', objectives),
  section('Scope', scope),
  section('Deliverables', deliverables),
  section('Timeline', timeline),
  section('Payment schedule', paymentSchedule),
  section('Terms and conditions', termsAndConditions),
  section('Notes', notes),
].filter((s) => s.body);

function quantityLabel(quantity: number): string {
  const scaled = Math.round(Number(quantity) * 10_000);
  return formatScaledQuantity(scaled);
}
---

<div class="studio-proposal-doc">
  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted">
      {proposalNumber}
      <span class="mx-2" aria-hidden="true">·</span>
      Version {versionNumber}
      {
        isImmutable && (
          <>
            <span class="mx-2" aria-hidden="true">
              ·
            </span>
            Finalized
          </>
        )
      }
    </p>
    <h1 class="studio-doc-title mt-2">{title}</h1>
    <p class="studio-doc-lede">
      Prepared for {clientDisplayName}
      <span class="mx-2" aria-hidden="true">·</span>
      {projectName}
    </p>
    {
      expiresAt && (
        <p class="mt-2 text-sm text-ink-muted">Valid through {formatDateOnly(expiresAt)}</p>
      )
    }
    {
      finalizedAt && (
        <p class="mt-1 text-sm text-ink-muted">
          Snapshot finalized {formatDateOnly(finalizedAt)}
        </p>
      )
    }
  </header>

  {
    sections.map((entry) => (
      <section class="mb-8">
        <h2 class="font-display text-lg font-semibold text-navy-900">{entry.label}</h2>
        <p class="studio-prewrap mt-3 text-sm leading-relaxed text-navy-900">{entry.body}</p>
      </section>
    ))
  }

  <section class="mb-8">
    <h2 class="font-display text-lg font-semibold text-navy-900">Investment</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="studio-table w-full text-sm">
        <thead>
          <tr>
            <th scope="col">Description</th>
            <th scope="col" class="text-right">
              Qty
            </th>
            <th scope="col" class="text-right">
              Rate
            </th>
            <th scope="col" class="text-right">
              Amount
            </th>
          </tr>
        </thead>
        <tbody>
          {items.map((item) => (
            <tr>
              <td>
                <span class="font-medium text-navy-900">{item.description}</span>
                {(item.optional || item.item_type !== 'service') && (
                  <p class="mt-0.5 text-xs text-ink-muted capitalize">
                    {item.item_type.replaceAll('_', ' ')}
                    {item.optional && (item.selected ? ' · optional (selected)' : ' · optional')}
                  </p>
                )}
              </td>
              <td class="tabular-nums text-right">{quantityLabel(Number(item.quantity))}</td>
              <td class="tabular-nums text-right">
                {formatMoney(item.rate_minor, currency)}
              </td>
              <td class="tabular-nums text-right">
                {formatMoney(item.amount_minor, currency)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <dl class="mt-6 ml-auto grid max-w-xs gap-2 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-ink-muted">Subtotal</dt>
        <dd class="tabular-nums font-medium text-navy-900">
          {formatMoney(subtotalMinor, currency)}
        </dd>
      </div>
      {
        discountMinor > 0 && (
          <div class="flex justify-between gap-4">
            <dt class="text-ink-muted">Discount</dt>
            <dd class="tabular-nums font-medium text-navy-900">
              −{formatMoney(discountMinor, currency)}
            </dd>
          </div>
        )
      }
      <div class="flex justify-between gap-4">
        <dt class="text-ink-muted">Tax ({taxPercent}%)</dt>
        <dd class="tabular-nums font-medium text-navy-900">
          {formatMoney(taxMinor, currency)}
        </dd>
      </div>
      <div class="flex justify-between gap-4 border-t border-border pt-2">
        <dt class="font-semibold text-navy-900">Total</dt>
        <dd class="tabular-nums font-semibold text-navy-900">
          {formatMoney(totalMinor, currency)}
        </dd>
      </div>
    </dl>
  </section>
</div>
