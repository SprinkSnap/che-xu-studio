---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you requested could not be found on Che Xu Studio."
  path="/404"
  noindex={true}
>
  <section class="section">
    <div class="container-shell max-w-xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-navy-900">This page is offline</h1>
      <p class="lead mt-4">
        The link may be outdated, or the page may have moved. Try one of these helpful paths instead.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Go to homepage</a>
        <a href="/pricing" class="btn-secondary">View pricing packages</a>
        <a href="/contact" class="btn-secondary">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
