---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalCta from '../components/FinalCta.astro';
import { siteConfig } from '../config/site';
import { breadcrumbSchema } from '../lib/seo';
---

<BaseLayout
  title="About Che Xu Studio"
  description="Che Xu Studio provides conversion-focused custom web design, brand identity, SEO strategy, and website care for Canadian small businesses—with clear CAD pricing and direct collaboration."
  path="/about"
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]),
  ]}
>
  <section class="section">
    <div class="container-shell max-w-3xl">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'About' }]} />
      <p class="eyebrow">About</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-navy-900 sm:text-5xl">
        {siteConfig.name}
      </h1>
      <p class="mt-4 text-xl font-medium text-navy-700">{siteConfig.tagline}</p>
      <div class="prose mt-8 space-y-4 text-base leading-relaxed text-ink-muted">
        <p>
          Che Xu Studio helps Canadian small and growing businesses get found, win more qualified enquiries, and stay online—with brand identity, conversion-focused custom web design, practical SEO strategy, and dependable website care.
        </p>
        <p>
          You work directly with the person designing and building your website. That means clearer communication, transparent starting prices in CAD, honest SEO expectations, and scope confirmed before invoicing—never pressure tactics or fake urgency.
        </p>
        <p>
          Whether you need brand identity, a custom website, SEO launch foundations, monthly growth, or ongoing care, we help you choose the right package—not the most expensive one by default.
        </p>
      </div>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={siteConfig.cta.primary.href} class="btn-primary">{siteConfig.cta.primary.label}</a>
        <a href="/work" class="btn-secondary">View selected work</a>
      </div>
    </div>
  </section>
  <FinalCta />
</BaseLayout>
