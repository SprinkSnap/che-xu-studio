---
import StudioLayout from '../../../../layouts/StudioLayout.astro';
import StudioPageHeader from '../../../../components/studio/StudioPageHeader.astro';
import StudioPanel from '../../../../components/studio/StudioPanel.astro';
import ClientFormFields from '../../../../components/studio/clients/ClientFormFields.astro';
import { requireStudioPermission } from '../../../../lib/auth/require';
import { isSameOriginMutation, requestSiteOrigin } from '../../../../lib/auth/origin';
import { getClientById } from '../../../../lib/clients/queries';
import { ClientMutationError, updateClient } from '../../../../lib/clients/mutations';
import {
  clientWriteSchema,
  formDataToObject,
  CLIENT_CONFLICT_ERROR,
  GENERIC_CLIENT_SAVE_ERROR,
  uuidParamSchema,
} from '../../../../lib/clients/validation';
import {
  clientRowToFormValues,
  emptyClientFormValues,
  type ClientFormValues,
} from '../../../../lib/clients/form-values';
import { clientDisplayName } from '../../../../lib/clients/format';

export const prerender = false;

const auth = await requireStudioPermission(Astro, 'studio.clients.write');
const supabase = Astro.locals.studioSupabase;
if (!supabase) {
  return Astro.redirect('/admin/login');
}

const idParsed = uuidParamSchema.safeParse(Astro.params.id);
if (!idParsed.success) {
  return new Response('Not found', { status: 404 });
}
const clientId = idParsed.data;

let client = await getClientById(supabase, clientId);
if (!client) {
  return new Response('Not found', {
    status: 404,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'Cache-Control': 'private, no-store',
      'X-Robots-Tag': 'noindex, nofollow, noarchive',
    },
  });
}

let errorMessage = '';
let values: ClientFormValues = clientRowToFormValues(client);

if (Astro.request.method === 'POST') {
  const origin = requestSiteOrigin(Astro.request, Astro.url);
  if (!isSameOriginMutation(Astro.request, origin)) {
    return new Response('Invalid request origin.', { status: 403 });
  }

  const form = await Astro.request.formData();
  const raw = formDataToObject(form);
  values = {
    ...emptyClientFormValues(),
    companyName: raw.companyName ?? '',
    displayName: raw.displayName ?? '',
    billingEmail: raw.billingEmail ?? '',
    phone: raw.phone ?? '',
    billingAddressLine1: raw.billingAddressLine1 ?? '',
    billingAddressLine2: raw.billingAddressLine2 ?? '',
    billingCity: raw.billingCity ?? '',
    billingRegion: raw.billingRegion ?? '',
    billingPostalCode: raw.billingPostalCode ?? '',
    billingCountry: raw.billingCountry ?? 'CA',
    companySameAsBilling: raw.companySameAsBilling === 'on',
    companyAddressLine1: raw.companyAddressLine1 ?? '',
    companyAddressLine2: raw.companyAddressLine2 ?? '',
    companyCity: raw.companyCity ?? '',
    companyRegion: raw.companyRegion ?? '',
    companyPostalCode: raw.companyPostalCode ?? '',
    companyCountry: raw.companyCountry ?? 'CA',
    notes: raw.notes ?? '',
    expectedUpdatedAt: raw.expectedUpdatedAt,
  };

  const parsed = clientWriteSchema.safeParse({
    ...raw,
    expectedUpdatedAt: raw.expectedUpdatedAt || undefined,
  });

  if (!parsed.success) {
    errorMessage = parsed.error.issues[0]?.message || GENERIC_CLIENT_SAVE_ERROR;
  } else {
    try {
      await updateClient(supabase, clientId, parsed.data, auth.profile.id);
      return Astro.redirect(`/admin/clients/${clientId}?notice=saved`, 303);
    } catch (error) {
      if (error instanceof ClientMutationError && error.code === 'conflict') {
        errorMessage = CLIENT_CONFLICT_ERROR;
        const refreshed = await getClientById(supabase, clientId);
        if (refreshed) {
          client = refreshed;
          values = { ...clientRowToFormValues(refreshed), ...values, expectedUpdatedAt: refreshed.updated_at };
        }
      } else {
        errorMessage =
          error instanceof ClientMutationError ? error.message : GENERIC_CLIENT_SAVE_ERROR;
      }
    }
  }
}
---

<StudioLayout
  title={`Edit ${clientDisplayName(client)}`}
  description="Edit Studio client details."
>
  <StudioPageHeader
    slot="header"
    title="Edit client"
    description={clientDisplayName(client)}
  />
  <a slot="actions" class="studio-action" href={`/admin/clients/${clientId}`}>Back to client</a>

  <StudioPanel title="Client details">
    <form method="post" action={`/admin/clients/${clientId}/edit`} novalidate>
      <ClientFormFields values={values} mode="edit" errorMessage={errorMessage} />
      <div class="studio-actions mt-2">
        <button type="submit" class="studio-action studio-action-primary">Save changes</button>
        <a class="studio-action" href={`/admin/clients/${clientId}`}>Cancel</a>
      </div>
    </form>
  </StudioPanel>
</StudioLayout>
