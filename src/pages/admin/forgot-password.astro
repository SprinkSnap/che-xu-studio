---
import StudioAuthLayout from '../../layouts/StudioAuthLayout.astro';
import {
  GENERIC_FORGOT_PASSWORD_MESSAGE,
  forgotPasswordSchema,
} from '../../lib/auth/validation';
import { isSameOriginMutation, requestSiteOrigin } from '../../lib/auth/origin';
import { enforceAuthRateLimit, readAuthRateLimiter } from '../../lib/auth/rate-limit';
import { resolveStudioBaseUrl, studioResetPasswordUrl } from '../../lib/auth/studio-url';
import { recordAuthActivity, sanitizeAuthMetadata, emailDomain } from '../../lib/auth/activity';
import { logStudioAuthEvent } from '../../lib/supabase/auth';

export const prerender = false;

let submitted = false;
let emailValue = '';

if (Astro.request.method === 'POST') {
  const limiter = await readAuthRateLimiter();
  const limited = await enforceAuthRateLimit({
    request: Astro.request,
    limiter,
    bucket: 'forgot',
  });
  if (limited) return limited;

  const origin = requestSiteOrigin(Astro.request, Astro.url);
  if (!isSameOriginMutation(Astro.request, origin)) {
    return new Response('Invalid request origin.', {
      status: 403,
      headers: {
        'Content-Type': 'text/plain; charset=utf-8',
        'Cache-Control': 'private, no-store',
      },
    });
  }

  const form = await Astro.request.formData();
  const parsed = forgotPasswordSchema.safeParse({
    email: String(form.get('email') ?? '').trim().toLowerCase(),
  });

  // Always show the same response to avoid account enumeration.
  submitted = true;
  emailValue = parsed.success ? parsed.data.email : String(form.get('email') ?? '');

  if (parsed.success) {
    const supabase = Astro.locals.studioSupabase;
    if (supabase) {
      const baseUrl = resolveStudioBaseUrl({
        requestUrl: Astro.url,
        STUDIO_BASE_URL:
          (typeof process !== 'undefined' ? process.env.STUDIO_BASE_URL : undefined) ??
          import.meta.env.STUDIO_BASE_URL,
      });
      const redirectTo = studioResetPasswordUrl(baseUrl);
      const { error } = await supabase.auth.resetPasswordForEmail(parsed.data.email, {
        redirectTo,
      });
      if (error) {
        logStudioAuthEvent('password_reset_request_error', { message: error.message });
      } else {
        logStudioAuthEvent('password_reset_requested');
      }
      await recordAuthActivity(supabase, {
        action: 'auth.password_reset_requested',
        metadata: sanitizeAuthMetadata({
          emailDomain: emailDomain(parsed.data.email),
        }),
      });
    }
  }
}
---

<StudioAuthLayout title="Forgot password" description="Reset your Che Xu Studio password.">
  <h1>Forgot password</h1>
  <p class="studio-auth-lede">
    Enter your email. If the account is eligible, we will send reset instructions.
  </p>

  {
    submitted ? (
      <p class="studio-auth-success mt-6" role="status">
        {GENERIC_FORGOT_PASSWORD_MESSAGE}
      </p>
    ) : (
      <form class="studio-auth-form" method="post" action="/admin/forgot-password" novalidate>
        <div class="studio-auth-field">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            value={emailValue}
          />
        </div>
        <button type="submit" class="studio-action studio-action-primary w-full">
          Send reset instructions
        </button>
      </form>
    )
  }

  <div class="studio-auth-links">
    <a href="/admin/login">Back to sign in</a>
  </div>
</StudioAuthLayout>
