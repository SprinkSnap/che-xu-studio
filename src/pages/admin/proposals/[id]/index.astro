---
import StudioLayout from '../../../../layouts/StudioLayout.astro';
import StudioPageHeader from '../../../../components/studio/StudioPageHeader.astro';
import StudioPanel from '../../../../components/studio/StudioPanel.astro';
import StudioEmptyState from '../../../../components/studio/StudioEmptyState.astro';
import StudioStatusBadge from '../../../../components/studio/StudioStatusBadge.astro';
import { requireStudioPermission } from '../../../../lib/auth/require';
import { isSameOriginMutation, requestSiteOrigin } from '../../../../lib/auth/origin';
import { roleHasPermission } from '../../../../lib/auth/permissions';
import { getProposalDetail } from '../../../../lib/proposals/queries';
import {
  archiveProposal,
  createProposalRevision,
  finalizeProposalVersion,
  ProposalMutationError,
} from '../../../../lib/proposals/mutations';
import {
  getOrCreateDepositInvoice,
  getOrCreateFinalInvoice,
} from '../../../../lib/invoices/generation';
import { listInvoicesForProposal } from '../../../../lib/invoices/queries';
import { InvoiceMutationError } from '../../../../lib/invoices/mutations';
import {
  INVOICE_TYPE_LABELS,
  displayInvoiceStatus,
  todayIsoDateUtc,
  invoiceStatusTone,
  type InvoiceStatus,
  type InvoiceType,
} from '../../../../lib/invoices/workflow';
import {
  GENERIC_ARCHIVE_ERROR,
  GENERIC_FINALIZE_ERROR,
  GENERIC_REVISION_ERROR,
  uuidParamSchema,
} from '../../../../lib/proposals/validation';
import { GENERIC_GENERATE_ERROR } from '../../../../lib/invoices/validation';
import {
  createProposalPublicLink,
  revokeProposalPublicLink,
  listProposalPublicLinks,
  PublicLinkError,
} from '../../../../lib/public-links/mutations';
import { listChangeRequestsForProposal } from '../../../../lib/proposals/change-requests';
import {
  sendProposalEmail,
  resendProposalEmail,
  ProposalSendError,
} from '../../../../lib/email/proposal-send';
import { listEmailLogsForProposal } from '../../../../lib/email/logging';
import { isProposalCommerciallyExpired } from '../../../../lib/public-links/resolve';
import type { PublicLinkRow } from '../../../../lib/public-links/types';
import {
  canArchiveProposal,
  canCreateProposalRevision,
  canFinalizeProposalVersion,
  isProposalVersionEditable,
  PROPOSAL_STATUS_LABELS,
  proposalStatusTone,
  type ProposalStatus,
} from '../../../../lib/proposals/workflow';
import {
  clientDisplayName,
  formatDateOnly,
  formatMoney,
  formatStudioDateTime,
} from '../../../../lib/clients/format';
import { bpsToPercentInput } from '../../../../lib/money/parse';
import { humanizeStudioActivity } from '../../../../lib/studio/activity';
import type { CurrencyCode } from '../../../../lib/supabase/domain';

export const prerender = false;

const auth = await requireStudioPermission(Astro, 'studio.proposals.read');
const canWrite = roleHasPermission(auth.profile.role, 'studio.proposals.write');
const canWriteInvoices = roleHasPermission(auth.profile.role, 'studio.invoices.write');
const supabase = Astro.locals.studioSupabase;
if (!supabase) {
  return Astro.redirect('/admin/login');
}

const idParsed = uuidParamSchema.safeParse(Astro.params.id);
if (!idParsed.success) {
  return new Response('Not found', { status: 404 });
}
const proposalId = idParsed.data;

let flashError = '';
let flashSuccess = '';
let createdClientLinkUrl = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const isInvoiceGenerate = intent === 'generate_deposit' || intent === 'generate_final';
  const permitted =
    (isInvoiceGenerate && canWriteInvoices) || (!isInvoiceGenerate && canWrite);

  if (!permitted) {
    flashError = 'You do not have permission to perform this action.';
  } else {
    const origin = requestSiteOrigin(Astro.request, Astro.url);
    if (!isSameOriginMutation(Astro.request, origin)) {
      return new Response('Invalid request origin.', { status: 403 });
    }

    const actorId = auth.profile.id;
    const versionId = String(form.get('versionId') ?? '');
    const linkId = String(form.get('linkId') ?? '');

    try {
      if (intent === 'finalize') {
        const versionParsed = uuidParamSchema.safeParse(versionId);
        if (!versionParsed.success) {
          flashError = GENERIC_FINALIZE_ERROR;
        } else {
          await finalizeProposalVersion(
            supabase,
            proposalId,
            versionParsed.data,
            actorId,
          );
          return Astro.redirect(`/admin/proposals/${proposalId}?notice=finalized`, 303);
        }
      } else if (intent === 'revision') {
        await createProposalRevision(supabase, proposalId, actorId);
        return Astro.redirect(`/admin/proposals/${proposalId}?notice=revision`, 303);
      } else if (intent === 'archive') {
        await archiveProposal(supabase, proposalId, actorId);
        return Astro.redirect(`/admin/proposals/${proposalId}?notice=archived`, 303);
      } else if (intent === 'create_client_link') {
        const versionParsed = uuidParamSchema.safeParse(versionId);
        if (!versionParsed.success) {
          flashError = 'Select a finalized version to create a client link.';
        } else {
          const created = await createProposalPublicLink(supabase, {
            proposalId,
            proposalVersionId: versionParsed.data,
            actorProfileId: actorId,
            siteOrigin: origin,
          });
          createdClientLinkUrl = created.rawUrl;
          flashSuccess =
            'Client link created. Copy it now — the raw URL is not stored and cannot be shown again.';
        }
      } else if (intent === 'revoke_client_link') {
        const linkParsed = uuidParamSchema.safeParse(linkId);
        if (!linkParsed.success) {
          flashError = 'Unable to revoke client link.';
        } else {
          await revokeProposalPublicLink(supabase, {
            proposalId,
            linkId: linkParsed.data,
            actorProfileId: actorId,
          });
          return Astro.redirect(`/admin/proposals/${proposalId}?notice=link_revoked`, 303);
        }
      } else if (intent === 'send_proposal' || intent === 'resend_proposal') {
        const recipientOverride = String(form.get('recipientEmail') ?? '').trim() || null;
        const result =
          intent === 'resend_proposal'
            ? await resendProposalEmail(supabase, {
                proposalId,
                actorProfileId: actorId,
                recipientEmail: recipientOverride,
              })
            : await sendProposalEmail(supabase, {
                proposalId,
                actorProfileId: actorId,
                recipientEmail: recipientOverride,
              });
        return Astro.redirect(
          `/admin/proposals/${proposalId}?notice=${result.alreadySent ? 'already_sent' : 'email_sent'}`,
          303,
        );
      } else if (intent === 'generate_pdf' || intent === 'regenerate_pdf') {
        const versionParsed = uuidParamSchema.safeParse(versionId);
        if (!versionParsed.success) {
          flashError = 'Select a finalized version to generate a PDF.';
        } else {
          const { getOrCreateProposalPdf, ProposalPdfError: PdfErr } = await import(
            '../../../../lib/pdf/proposal'
          );
          try {
            await getOrCreateProposalPdf(supabase, {
              proposalId,
              versionId: versionParsed.data,
              actorProfileId: actorId,
              forceRegenerate: intent === 'regenerate_pdf',
            });
            return Astro.redirect(
              `/admin/proposals/${proposalId}?notice=${intent === 'regenerate_pdf' ? 'pdf_regen' : 'pdf_ready'}`,
              303,
            );
          } catch (pdfError) {
            if (pdfError instanceof PdfErr) flashError = pdfError.message;
            else flashError = 'Unable to generate PDF.';
          }
        }
      } else if (isInvoiceGenerate) {
        const versionParsed = uuidParamSchema.safeParse(versionId);
        if (!versionParsed.success) {
          flashError = GENERIC_GENERATE_ERROR;
        } else {
          const result =
            intent === 'generate_deposit'
              ? await getOrCreateDepositInvoice(supabase, {
                  proposalId,
                  proposalVersionId: versionParsed.data,
                  actorProfileId: actorId,
                })
              : await getOrCreateFinalInvoice(supabase, {
                  proposalId,
                  proposalVersionId: versionParsed.data,
                  actorProfileId: actorId,
                });
          return Astro.redirect(
            `/admin/invoices/${result.invoiceId}?notice=${result.created ? 'generated' : 'existing'}`,
            303,
          );
        }
      }
    } catch (error) {
      if (
        error instanceof ProposalMutationError ||
        error instanceof InvoiceMutationError ||
        error instanceof PublicLinkError ||
        error instanceof ProposalSendError
      ) {
        flashError = error.message;
      } else if (intent === 'finalize') {
        flashError = GENERIC_FINALIZE_ERROR;
      } else if (intent === 'revision') {
        flashError = GENERIC_REVISION_ERROR;
      } else if (intent === 'archive') {
        flashError = GENERIC_ARCHIVE_ERROR;
      } else if (intent === 'send_proposal' || intent === 'resend_proposal') {
        flashError = 'Unable to send proposal email.';
      } else if (isInvoiceGenerate) {
        flashError = GENERIC_GENERATE_ERROR;
      } else {
        flashError = 'Unable to update proposal.';
      }
    }
  }
}

let detail = null as Awaited<ReturnType<typeof getProposalDetail>>;
try {
  detail = await getProposalDetail(supabase, proposalId);
} catch {
  detail = null;
}

if (!detail) {
  return new Response('Not found', {
    status: 404,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'Cache-Control': 'private, no-store',
      'X-Robots-Tag': 'noindex, nofollow, noarchive',
    },
  });
}

const notice = Astro.url.searchParams.get('notice');
const noticeMap: Record<string, string> = {
  finalized: 'Version finalized. Status remains draft until the proposal email is accepted by the provider.',
  revision: 'New editable revision created.',
  archived: 'Proposal archived.',
  saved: 'Proposal draft saved.',
  link_revoked: 'Client link revoked.',
  email_sent: 'Proposal email accepted by the provider. Proposal marked Sent.',
  already_sent: 'Proposal delivery was already recorded for this version.',
  pdf_ready: 'Proposal PDF is ready to download.',
  pdf_regen: 'Proposal PDF regenerated. Prior generation is preserved in history.',
};
if (notice && noticeMap[notice]) flashSuccess = noticeMap[notice];

const { proposal, version, items, versions, client, project, activity } = detail;
const status = proposal.status as ProposalStatus;
const currency = version.currency as CurrencyCode;
const editable = isProposalVersionEditable({
  proposalStatus: status,
  versionImmutable: version.is_immutable,
});
const canFinalize =
  canWrite &&
  canFinalizeProposalVersion({
    proposalStatus: status,
    versionImmutable: version.is_immutable,
  });
const canRevision =
  canWrite &&
  canCreateProposalRevision({
    proposalStatus: status,
    currentVersionImmutable: version.is_immutable,
  });
const canArchive = canWrite && canArchiveProposal(status);
const clientName = clientDisplayName(client);
const relatedInvoices = await listInvoicesForProposal(supabase, proposal.id);
const invoiceToday = todayIsoDateUtc();
const canGenerateInvoices = canWriteInvoices && status !== 'archived';
const publicLinks = await listProposalPublicLinks(supabase, proposal.id);
const changeRequests = await listChangeRequestsForProposal(supabase, proposal.id);
const { data: acceptanceRow } = await supabase
  .from('proposal_acceptances')
  .select('id, accepted_by_name, accepted_by_email, accepted_at, proposal_version_id')
  .eq('proposal_id', proposal.id)
  .order('accepted_at', { ascending: false })
  .limit(1)
  .maybeSingle();

function linkStatusLabel(link: PublicLinkRow): string {
  if (link.revoked_at) return 'Revoked';
  if (acceptanceRow && acceptanceRow.proposal_version_id === link.proposal_version_id) {
    return 'Accepted';
  }
  if (isProposalCommerciallyExpired(proposal.expires_at)) return 'Expired';
  if (link.first_viewed_at) return 'Viewed';
  return 'Active';
}

const canCreateClientLink = canWrite && version.is_immutable && status !== 'archived';
const canSendProposal =
  canWrite &&
  version.is_immutable &&
  status !== 'archived' &&
  status !== 'accepted' &&
  !proposal.accepted_at;
const emailLogs = await listEmailLogsForProposal(supabase, proposal.id);
const defaultRecipient =
  version.client_contact_email?.trim() ||
  '';
---

<StudioLayout
  title={proposal.proposal_number}
  description={`Proposal ${proposal.proposal_number}.`}
>
  <StudioPageHeader
    slot="header"
    title={proposal.proposal_number}
    description={proposal.title}
  />
  <Fragment slot="actions">
    {
      canWrite && editable && (
        <a class="studio-action studio-action-primary" href={`/admin/proposals/${proposal.id}/edit`}>
          Edit draft
        </a>
      )
    }
    <a class="studio-action" href={`/admin/proposals/${proposal.id}/preview`}>
      Preview
    </a>
    {
      version.is_immutable && (
        <a
          class="studio-action"
          href={`/api/studio/proposals/${proposal.id}/pdf?versionId=${version.id}`}
        >
          Download PDF
        </a>
      )
    }
    <a class="studio-action" href={`/admin/projects/${project.id}`}>
      View project
    </a>
    <a class="studio-action" href="/admin/proposals">All proposals</a>
  </Fragment>

  {
    flashError && (
      <p class="studio-auth-error mb-6" role="alert">
        {flashError}
      </p>
    )
  }
  {
    flashSuccess && (
      <p class="studio-auth-success mb-6" role="status">
        {flashSuccess}
      </p>
    )
  }

  {
    createdClientLinkUrl && (
      <div class="mb-6 rounded-[var(--radius-md)] border border-border bg-white p-4" role="status">
        <p class="text-sm font-medium text-navy-900">Copy client link (shown once)</p>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center">
          <input
            id="created-client-link"
            class="w-full min-h-11 rounded-[var(--radius-md)] border border-border px-3 text-sm"
            type="text"
            readonly
            value={createdClientLinkUrl}
          />
          <button type="button" class="studio-action studio-action-primary" data-copy-client-link>
            Copy Client Link
          </button>
        </div>
        <p class="mt-2 text-xs text-ink-muted">
          Raw tokens are not stored. If lost, revoke and create a replacement link.
        </p>
      </div>
    )
  }

  <div class="mb-6 flex flex-wrap items-center gap-3">
    <StudioStatusBadge
      label={PROPOSAL_STATUS_LABELS[status]}
      tone={proposalStatusTone(status)}
    />
    <span class="text-sm text-ink-muted">
      Version {version.version_number}
      {version.is_immutable ? ' · finalized' : ' · editable draft'}
    </span>
  </div>

  {
    canWrite && (canFinalize || canRevision || canArchive) && (
      <div class="studio-actions mb-8">
        {canFinalize && (
          <form method="post" action={`/admin/proposals/${proposal.id}`}>
            <input type="hidden" name="intent" value="finalize" />
            <input type="hidden" name="versionId" value={version.id} />
            <button type="submit" class="studio-action studio-action-primary" data-confirm-finalize>
              Finalize version
            </button>
          </form>
        )}
        {canRevision && (
          <form method="post" action={`/admin/proposals/${proposal.id}`}>
            <input type="hidden" name="intent" value="revision" />
            <button type="submit" class="studio-action">Create revision</button>
          </form>
        )}
        {canArchive && (
          <form method="post" action={`/admin/proposals/${proposal.id}`}>
            <input type="hidden" name="intent" value="archive" />
            <button type="submit" class="studio-action" data-confirm-archive>
              Archive
            </button>
          </form>
        )}
      </div>
    )
  }

  <div class="studio-detail-grid mb-8">
    <StudioPanel title="Overview">
      <dl class="studio-dl">
        <div>
          <dt>Client</dt>
          <dd>
            <a class="studio-client-link" href={`/admin/clients/${client.id}`}>
              {clientName}
            </a>
          </dd>
        </div>
        <div>
          <dt>Project</dt>
          <dd>
            <a class="studio-client-link" href={`/admin/projects/${project.id}`}>
              {project.name}
            </a>
          </dd>
        </div>
        <div>
          <dt>Expires</dt>
          <dd>{formatDateOnly(proposal.expires_at || version.expires_at)}</dd>
        </div>
        <div>
          <dt>Created</dt>
          <dd>{formatStudioDateTime(proposal.created_at)}</dd>
        </div>
        <div>
          <dt>Updated</dt>
          <dd>{formatStudioDateTime(proposal.updated_at)}</dd>
        </div>
        {
          version.finalized_at && (
            <div>
              <dt>Version finalized</dt>
              <dd>{formatStudioDateTime(version.finalized_at)}</dd>
            </div>
          )
        }
      </dl>
    </StudioPanel>

    <StudioPanel title="Financial summary">
      <dl class="studio-dl">
        <div>
          <dt>Subtotal</dt>
          <dd class="studio-project-value">
            {formatMoney(version.subtotal_minor, currency)}
          </dd>
        </div>
        <div>
          <dt>Discount</dt>
          <dd>{formatMoney(version.discount_minor, currency)}</dd>
        </div>
        <div>
          <dt>Tax ({bpsToPercentInput(version.tax_bps)}%)</dt>
          <dd>{formatMoney(version.tax_minor, currency)}</dd>
        </div>
        <div>
          <dt>Total</dt>
          <dd class="studio-project-value">
            {formatMoney(version.total_minor, currency)}
          </dd>
        </div>
        <div>
          <dt>Deposit</dt>
          <dd>{bpsToPercentInput(version.deposit_bps)}%</dd>
        </div>
        <div>
          <dt>Line items</dt>
          <dd>{items.length}</dd>
        </div>
      </dl>
      <p class="mt-4 text-xs text-ink-muted">
        Totals are stored from server-side calculation. Finalizing does not mark the proposal as
        sent.
      </p>
    </StudioPanel>
  </div>

  <div class="studio-detail-grid mb-8">
    <StudioPanel title="Version history">
      {
        versions.length === 0 ? (
          <StudioEmptyState title="No versions" description="Versions will appear here." />
        ) : (
          <ul class="divide-y divide-border" role="list">
            {versions.map((entry) => (
              <li class="flex flex-wrap items-center justify-between gap-3 py-3 text-sm">
                <div>
                  <a
                    class="studio-client-link"
                    href={`/admin/proposals/${proposal.id}/versions/${entry.id}`}
                  >
                    Version {entry.version_number}
                  </a>
                  <p class="mt-1 text-ink-muted">
                    {entry.is_immutable ? 'Finalized' : 'Editable'}
                    <span class="mx-2" aria-hidden="true">
                      ·
                    </span>
                    {formatMoney(entry.total_minor, entry.currency as CurrencyCode)}
                    <span class="mx-2" aria-hidden="true">
                      ·
                    </span>
                    {formatStudioDateTime(entry.created_at)}
                  </p>
                </div>
                {entry.id === version.id && (
                  <span class="text-xs font-semibold uppercase tracking-wide text-ink-muted">
                    Current
                  </span>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </StudioPanel>

    <StudioPanel title="Activity">
      {
        activity.length === 0 ? (
          <StudioEmptyState
            title="No activity yet"
            description="Proposal changes will be listed here."
          />
        ) : (
          <ul class="divide-y divide-border" role="list">
            {activity.map((entry) => (
              <li class="flex flex-wrap items-baseline justify-between gap-2 py-3 text-sm">
                <span class="font-medium text-navy-900">
                  {humanizeStudioActivity(entry.action)}
                </span>
                <time class="text-ink-muted" datetime={entry.created_at}>
                  {formatStudioDateTime(entry.created_at)}
                </time>
              </li>
            ))}
          </ul>
        )
      }
    </StudioPanel>

    <StudioPanel title="Email history">
      {
        emailLogs.length === 0 ? (
          <StudioEmptyState
            title="No emails yet"
            description="Outbound proposal emails and notifications will appear here."
          />
        ) : (
          <ul class="divide-y divide-border" role="list">
            {emailLogs.map((entry) => (
              <li class="flex flex-wrap items-baseline justify-between gap-2 py-3 text-sm">
                <div>
                  <p class="font-medium text-navy-900">{entry.subject}</p>
                  <p class="mt-1 text-ink-muted">
                    {entry.email_type} · {entry.recipient_email} · {entry.status}
                    {entry.failure_reason ? ` · ${entry.failure_reason}` : ''}
                  </p>
                </div>
                <time class="text-ink-muted" datetime={entry.sent_at ?? entry.created_at}>
                  {formatStudioDateTime(entry.sent_at ?? entry.created_at)}
                </time>
              </li>
            ))}
          </ul>
        )
      }
    </StudioPanel>

    {
      version.is_immutable && canWrite && (
        <StudioPanel title="PDF document">
          <div class="flex flex-wrap gap-2">
            <form method="post">
              <input type="hidden" name="intent" value="generate_pdf" />
              <input type="hidden" name="versionId" value={version.id} />
              <button type="submit" class="studio-action studio-action-primary">
                Generate PDF
              </button>
            </form>
            <form method="post">
              <input type="hidden" name="intent" value="regenerate_pdf" />
              <input type="hidden" name="versionId" value={version.id} />
              <button type="submit" class="studio-action">
                Regenerate PDF
              </button>
            </form>
            <a
              class="studio-action"
              href={`/api/studio/proposals/${proposal.id}/pdf?versionId=${version.id}`}
            >
              Download PDF
            </a>
          </div>
          <p class="mt-3 text-sm text-ink-muted">
            Canonical PDF is bound to Version {version.version_number}. Regeneration preserves prior
            files.
          </p>
        </StudioPanel>
      )
    }
  </div>

  <div class="mb-8">
    <StudioPanel title="Client link & acceptance">
      {
        canSendProposal && (
          <form method="post" class="mb-6 space-y-3">
            <input
              type="hidden"
              name="intent"
              value={status === 'sent' || status === 'viewed' || status === 'changes_requested' ? 'resend_proposal' : 'send_proposal'}
            />
              <label class="studio-auth-field">
                <span class="text-ink-muted">Recipient email</span>
                <input
                  type="email"
                  name="recipientEmail"
                  value={defaultRecipient}
                  required
                  autocomplete="email"
                />
              </label>
            <button type="submit" class="studio-action studio-action-primary">
              {status === 'draft' || status === 'expired' || status === 'declined'
                ? 'Send Proposal'
                : 'Resend Proposal'}
            </button>
            <p class="text-sm text-ink-muted">
              Marks the proposal Sent only after the email provider accepts delivery. A fresh
              exact-version secure link is minted for this send.
            </p>
          </form>
        )
      }

      <dl class="mb-6 grid gap-3 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-ink-muted">Acceptance</dt>
          <dd class="mt-1 text-navy-900">
            {
              acceptanceRow
                ? `Accepted by ${acceptanceRow.accepted_by_name} (${acceptanceRow.accepted_by_email}) on ${formatStudioDateTime(acceptanceRow.accepted_at)}`
                : 'Not accepted'
            }
          </dd>
        </div>
        <div>
          <dt class="text-ink-muted">Proposal expiration</dt>
          <dd class="mt-1 text-navy-900">{formatDateOnly(proposal.expires_at)}</dd>
        </div>
      </dl>

      {
        canCreateClientLink && (
          <form method="post" class="mb-4">
            <input type="hidden" name="intent" value="create_client_link" />
            <input type="hidden" name="versionId" value={version.id} />
            <button type="submit" class="studio-action studio-action-primary">
              {publicLinks.some((l) => !l.revoked_at && l.proposal_version_id === version.id)
                ? 'Replace Client Link'
                : 'Create Client Link'}
            </button>
          </form>
        )
      }

      {
        !version.is_immutable && (
          <p class="mb-4 text-sm text-ink-muted">
            Finalize this version before creating a client link.
          </p>
        )
      }

      {
        publicLinks.length === 0 ? (
          <StudioEmptyState
            title="No client links yet"
            description="Create a secure capability link after finalizing the proposal version."
          />
        ) : (
          <ul class="divide-y divide-border" role="list">
            {publicLinks.map((link) => (
              <li class="flex flex-wrap items-center justify-between gap-3 py-3 text-sm">
                <div>
                  <p class="font-medium text-navy-900">{linkStatusLabel(link)}</p>
                  <p class="mt-1 text-ink-muted">
                    Created {formatStudioDateTime(link.created_at)}
                    {link.first_viewed_at
                      ? ` · First viewed ${formatStudioDateTime(link.first_viewed_at)}`
                      : ''}
                    {link.expires_at ? ` · Expires ${formatStudioDateTime(link.expires_at)}` : ''}
                  </p>
                </div>
                {canWrite && !link.revoked_at && (
                  <form method="post">
                    <input type="hidden" name="intent" value="revoke_client_link" />
                    <input type="hidden" name="linkId" value={link.id} />
                    <button type="submit" class="studio-action">
                      Revoke
                    </button>
                  </form>
                )}
              </li>
            ))}
          </ul>
        )
      }

      {
        changeRequests.length > 0 && (
          <div class="mt-6 border-t border-border pt-4">
            <h3 class="text-sm font-semibold text-navy-900">Change requests</h3>
            <ul class="mt-3 divide-y divide-border" role="list">
              {changeRequests.map((req) => (
                <li class="py-3 text-sm">
                  <p class="font-medium text-navy-900">
                    {req.requested_by_name} · {formatStudioDateTime(req.created_at)}
                  </p>
                  <p class="mt-1 whitespace-pre-line text-ink-muted">{req.message}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </StudioPanel>
  </div>

  <div class="mb-8">
    <StudioPanel title="Related invoices">
      {
        !version.is_immutable && canGenerateInvoices && (
          <p class="mb-4 text-sm text-ink-muted">
            Prefer generating from a finalized proposal version. Current version is still editable.
          </p>
        )
      }
      {
        canGenerateInvoices && (
          <div class="mb-4 flex flex-wrap gap-3">
            <form method="post">
              <input type="hidden" name="intent" value="generate_deposit" />
              <input type="hidden" name="versionId" value={version.id} />
              <button type="submit" class="studio-action studio-action-primary">
                Generate deposit invoice
              </button>
            </form>
            <form method="post">
              <input type="hidden" name="intent" value="generate_final" />
              <input type="hidden" name="versionId" value={version.id} />
              <button type="submit" class="studio-action">
                Generate final invoice
              </button>
            </form>
          </div>
        )
      }
      {
        relatedInvoices.length === 0 ? (
          <StudioEmptyState
            title="No invoices yet"
            description="Generate deposit or final invoices from this proposal version. Generation is idempotent."
          />
        ) : (
          <ul class="divide-y divide-border" role="list">
            {relatedInvoices.map((invoice) => {
              const display = displayInvoiceStatus(
                {
                  status: invoice.status as InvoiceStatus,
                  due_date: null,
                  balance_due_minor: invoice.balance_due_minor,
                },
                invoiceToday,
              );
              return (
                <li class="flex flex-wrap items-center justify-between gap-3 py-3 text-sm">
                  <div>
                    <a class="studio-client-link" href={`/admin/invoices/${invoice.id}`}>
                      {invoice.invoice_number}
                    </a>
                    <p class="mt-1 text-ink-muted">
                      {INVOICE_TYPE_LABELS[(invoice.invoice_type as InvoiceType) || 'manual']}
                    </p>
                  </div>
                  <div class="flex flex-col items-end gap-2">
                    <StudioStatusBadge
                      label={display.label}
                      tone={invoiceStatusTone(invoice.status as InvoiceStatus, display.isOverdue)}
                    />
                    <span class="tabular-nums text-ink-muted">
                      {formatMoney(invoice.total_minor, invoice.currency as CurrencyCode)}
                      <span class="mx-2" aria-hidden="true">
                        ·
                      </span>
                      Bal {formatMoney(invoice.balance_due_minor, invoice.currency as CurrencyCode)}
                    </span>
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }
    </StudioPanel>
  </div>
</StudioLayout>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-confirm-finalize]').forEach((button) => {
      button.addEventListener('click', (event) => {
        if (
          !confirm(
            'Finalize this version? It becomes immutable. This does not send the proposal to the client.',
          )
        ) {
          event.preventDefault();
        }
      });
    });
    document.querySelectorAll('[data-confirm-archive]').forEach((button) => {
      button.addEventListener('click', (event) => {
        if (!confirm('Archive this proposal?')) event.preventDefault();
      });
    });
    const copyBtn = document.querySelector('[data-copy-client-link]');
    const input = document.getElementById('created-client-link');
    if (copyBtn instanceof HTMLButtonElement && input instanceof HTMLInputElement) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(input.value);
          copyBtn.textContent = 'Copied';
        } catch {
          input.select();
          copyBtn.textContent = 'Select & copy';
        }
      });
    }
  })();
</script>
