---
import StudioLayout from '../../../layouts/StudioLayout.astro';
import StudioPageHeader from '../../../components/studio/StudioPageHeader.astro';
import StudioPanel from '../../../components/studio/StudioPanel.astro';
import StudioEmptyState from '../../../components/studio/StudioEmptyState.astro';
import ProposalList from '../../../components/studio/proposals/ProposalList.astro';
import { requireStudioPermission } from '../../../lib/auth/require';
import { roleHasPermission } from '../../../lib/auth/permissions';
import { listProposals } from '../../../lib/proposals/queries';
import { proposalListQuerySchema } from '../../../lib/proposals/validation';

export const prerender = false;

const auth = await requireStudioPermission(Astro, 'studio.proposals.read');
const canWrite = roleHasPermission(auth.profile.role, 'studio.proposals.write');
const supabase = Astro.locals.studioSupabase;
if (!supabase) {
  return Astro.redirect('/admin/login');
}

const raw = Object.fromEntries(Astro.url.searchParams.entries());
const parsed = proposalListQuerySchema.safeParse(raw);
const query = parsed.success
  ? parsed.data
  : proposalListQuerySchema.parse({ status: 'active', sort: 'updated_desc', page: 1 });

let listError = '';
let result = {
  items: [] as Awaited<ReturnType<typeof listProposals>>['items'],
  total: 0,
  page: query.page,
  pageSize: query.pageSize,
  pageCount: 1,
};

try {
  result = await listProposals(supabase, query);
} catch {
  listError = 'Unable to load proposals.';
}

const hasFilters = Boolean(query.q) || query.status !== 'active';
const emptyTitle = hasFilters ? 'No proposals match this search.' : 'No proposals yet';
const emptyDescription = hasFilters
  ? 'Try a different number, title, or clear filters.'
  : 'Create a proposal from a project to start drafting.';
---

<StudioLayout title="Proposals" description="Proposal drafts and versioned snapshots.">
  <StudioPageHeader
    slot="header"
    title="Proposals"
    description="Draft, finalize, and revise proposals. Finalizing locks a version without sending it."
  />
  {
    canWrite ? (
      <a slot="actions" class="studio-action studio-action-primary" href="/admin/proposals/new">
        New Proposal
      </a>
    ) : (
      <Fragment slot="actions" />
    )
  }

  <StudioPanel title="Proposals">
    <form
      class="mb-6 grid gap-3 sm:grid-cols-[1fr_12rem_12rem_auto]"
      method="get"
      action="/admin/proposals"
    >
      <label class="block text-sm font-medium text-navy-900">
        Search
        <input
          type="search"
          name="q"
          value={query.q}
          class="mt-2 w-full min-h-11 rounded-[var(--radius-md)] border border-border bg-white px-3 text-sm"
          placeholder="Number, title, client, or project"
        />
      </label>
      <label class="block text-sm font-medium text-navy-900">
        Status
        <select
          name="status"
          class="mt-2 w-full min-h-11 rounded-[var(--radius-md)] border border-border bg-white px-3 text-sm"
        >
          <option value="active" selected={query.status === 'active'}>Active</option>
          <option value="all" selected={query.status === 'all'}>All</option>
          <option value="draft" selected={query.status === 'draft'}>Draft</option>
          <option value="sent" selected={query.status === 'sent'}>Sent</option>
          <option value="viewed" selected={query.status === 'viewed'}>Viewed</option>
          <option value="accepted" selected={query.status === 'accepted'}>Accepted</option>
          <option value="changes_requested" selected={query.status === 'changes_requested'}>
            Changes requested
          </option>
          <option value="expired" selected={query.status === 'expired'}>Expired</option>
          <option value="declined" selected={query.status === 'declined'}>Declined</option>
          <option value="archived" selected={query.status === 'archived'}>Archived</option>
        </select>
      </label>
      <label class="block text-sm font-medium text-navy-900">
        Sort
        <select
          name="sort"
          class="mt-2 w-full min-h-11 rounded-[var(--radius-md)] border border-border bg-white px-3 text-sm"
        >
          <option value="updated_desc" selected={query.sort === 'updated_desc'}>
            Recently updated
          </option>
          <option value="created_desc" selected={query.sort === 'created_desc'}>
            Newest created
          </option>
          <option value="number_asc" selected={query.sort === 'number_asc'}>
            Proposal number
          </option>
          <option value="expires_asc" selected={query.sort === 'expires_asc'}>
            Expires soon
          </option>
          <option value="value_desc" selected={query.sort === 'value_desc'}>
            Highest total
          </option>
        </select>
      </label>
      <div class="flex items-end">
        <button type="submit" class="studio-action w-full sm:w-auto">Apply</button>
      </div>
    </form>

    {
      listError ? (
        <p class="studio-auth-error" role="alert">
          {listError}
        </p>
      ) : result.items.length === 0 ? (
        <StudioEmptyState title={emptyTitle} description={emptyDescription}>
          {!hasFilters && canWrite && (
            <a class="studio-action studio-action-primary mt-2" href="/admin/projects">
              Browse projects
            </a>
          )}
        </StudioEmptyState>
      ) : (
        <>
          <p class="mb-4 text-sm text-ink-muted">
            {result.total} proposal{result.total === 1 ? '' : 's'}
          </p>
          <ProposalList items={result.items} />
          {result.pageCount > 1 && (
            <nav class="studio-pagination" aria-label="Proposal list pages">
              <p>
                Page {result.page} of {result.pageCount}
              </p>
              <div class="studio-actions">
                {result.page > 1 && (
                  <a
                    class="studio-action"
                    href={`/admin/proposals?${new URLSearchParams({
                      q: query.q,
                      status: query.status,
                      sort: query.sort,
                      page: String(result.page - 1),
                    }).toString()}`}
                  >
                    Previous
                  </a>
                )}
                {result.page < result.pageCount && (
                  <a
                    class="studio-action"
                    href={`/admin/proposals?${new URLSearchParams({
                      q: query.q,
                      status: query.status,
                      sort: query.sort,
                      page: String(result.page + 1),
                    }).toString()}`}
                  >
                    Next
                  </a>
                )}
              </div>
            </nav>
          )}
        </>
      )
    }
  </StudioPanel>
</StudioLayout>
