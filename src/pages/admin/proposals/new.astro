---
import StudioLayout from '../../../layouts/StudioLayout.astro';
import StudioPageHeader from '../../../components/studio/StudioPageHeader.astro';
import StudioPanel from '../../../components/studio/StudioPanel.astro';
import StudioEmptyState from '../../../components/studio/StudioEmptyState.astro';
import { requireStudioPermission } from '../../../lib/auth/require';
import { isSameOriginMutation, requestSiteOrigin } from '../../../lib/auth/origin';
import { getProjectById } from '../../../lib/projects/queries';
import { listProposalTemplates } from '../../../lib/proposals/queries';
import {
  createProposalFromProject,
  ProposalMutationError,
} from '../../../lib/proposals/mutations';
import {
  createProposalSchema,
  formDataToObject,
  GENERIC_PROPOSAL_SAVE_ERROR,
  uuidParamSchema,
} from '../../../lib/proposals/validation';
import { clientDisplayName } from '../../../lib/clients/format';

export const prerender = false;

const auth = await requireStudioPermission(Astro, 'studio.proposals.write');
const supabase = Astro.locals.studioSupabase;
if (!supabase) {
  return Astro.redirect('/admin/login');
}

const projectParam = Astro.url.searchParams.get('project') ?? '';
const projectParsed = uuidParamSchema.safeParse(projectParam);

let project = null as Awaited<ReturnType<typeof getProjectById>>;
let clientLabel = '';
let projectError = '';

if (!projectParsed.success) {
  projectError = 'Select a project to create a proposal. Open a project and use Create Proposal.';
} else {
  try {
    project = await getProjectById(supabase, projectParsed.data);
    if (!project || project.status === 'archived') {
      project = null;
      projectError = 'The selected project is unavailable.';
    } else {
      const { data: client } = await supabase
        .from('clients')
        .select('id, company_name, display_name')
        .eq('id', project.client_id)
        .maybeSingle();
      clientLabel = client ? clientDisplayName(client) : 'Client';
    }
  } catch {
    projectError = 'Unable to load the selected project.';
  }
}

const templates = project ? await listProposalTemplates(supabase) : [];

let errorMessage = '';
let titleValue = project ? `${project.name} Proposal` : '';
let templateIdValue = '';

if (Astro.request.method === 'POST') {
  const origin = requestSiteOrigin(Astro.request, Astro.url);
  if (!isSameOriginMutation(Astro.request, origin)) {
    return new Response('Invalid request origin.', { status: 403 });
  }

  if (!project) {
    errorMessage = projectError || 'Select a project to create a proposal.';
  } else {
    const form = await Astro.request.formData();
    const raw = formDataToObject(form);
    titleValue = raw.title ?? titleValue;
    templateIdValue = raw.templateId ?? '';

    const parsed = createProposalSchema.safeParse({
      projectId: project.id,
      templateId: raw.templateId,
      title: raw.title,
    });

    if (!parsed.success) {
      errorMessage = parsed.error.issues[0]?.message || GENERIC_PROPOSAL_SAVE_ERROR;
    } else {
      try {
        const proposalId = await createProposalFromProject(
          supabase,
          parsed.data,
          auth.profile.id,
        );
        return Astro.redirect(`/admin/proposals/${proposalId}`, 303);
      } catch (error) {
        errorMessage =
          error instanceof ProposalMutationError
            ? error.message
            : GENERIC_PROPOSAL_SAVE_ERROR;
      }
    }
  }
}
---

<StudioLayout title="New proposal" description="Create a proposal from a project.">
  <StudioPageHeader
    slot="header"
    title="New proposal"
    description="Proposals are always created from a project so client and pricing context stay linked."
  />
  <a slot="actions" class="studio-action" href="/admin/proposals">Back to proposals</a>

  {
    !project ? (
      <StudioPanel title="Project required">
        <StudioEmptyState
          title="Choose a project first"
          description={projectError}
        >
          <a class="studio-action studio-action-primary mt-2" href="/admin/projects">
            Browse projects
          </a>
        </StudioEmptyState>
      </StudioPanel>
    ) : (
      <StudioPanel title="Create proposal">
        <form
          method="post"
          action={`/admin/proposals/new?project=${project.id}`}
          novalidate
        >
          {errorMessage && (
            <p class="studio-auth-error mb-6" role="alert">
              {errorMessage}
            </p>
          )}
          <dl class="studio-dl mb-6">
            <div>
              <dt>Project</dt>
              <dd>
                <a class="studio-client-link" href={`/admin/projects/${project.id}`}>
                  {project.name}
                </a>
              </dd>
            </div>
            <div>
              <dt>Client</dt>
              <dd>
                <a class="studio-client-link" href={`/admin/clients/${project.client_id}`}>
                  {clientLabel}
                </a>
              </dd>
            </div>
          </dl>
          <input type="hidden" name="projectId" value={project.id} />
          <div class="studio-auth-field">
            <label for="title">Title</label>
            <input
              id="title"
              name="title"
              type="text"
              required
              maxlength="200"
              value={titleValue}
            />
          </div>
          <div class="studio-auth-field">
            <label for="templateId">
              Template <span class="font-normal text-ink-muted">(optional)</span>
            </label>
            <select id="templateId" name="templateId">
              <option value="" selected={!templateIdValue}>
                Studio default (if any)
              </option>
              {templates.map((template) => (
                <option value={template.id} selected={templateIdValue === template.id}>
                  {template.name}
                  {template.is_default ? ' (default)' : ''}
                </option>
              ))}
            </select>
            <p class="mt-2 text-xs text-ink-muted">
              Leaving this blank uses the default template when one is configured.
            </p>
          </div>
          <div class="studio-actions mt-2">
            <button type="submit" class="studio-action studio-action-primary">
              Create proposal
            </button>
            <a class="studio-action" href={`/admin/projects/${project.id}`}>
              Cancel
            </a>
          </div>
        </form>
      </StudioPanel>
    )
  }
</StudioLayout>
