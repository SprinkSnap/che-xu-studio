---
import StudioAuthLayout from '../../layouts/StudioAuthLayout.astro';
import StudioRecoverySession from '../../components/studio/StudioRecoverySession';
import { resetPasswordSchema } from '../../lib/auth/validation';
import { isSameOriginMutation, requestSiteOrigin } from '../../lib/auth/origin';
import { enforceAuthRateLimit, readAuthRateLimiter } from '../../lib/auth/rate-limit';
import { getAuthUser, getStudioAuthContext } from '../../lib/auth/profile';
import { recordAuthActivity, sanitizeAuthMetadata } from '../../lib/auth/activity';
import { logStudioAuthEvent } from '../../lib/supabase/auth';

export const prerender = false;

let errorMessage = '';
let recoveryReady = false;

const supabase = Astro.locals.studioSupabase;

if (supabase) {
  // Recovery links establish a session; validate without leaking token details.
  const user = await getAuthUser(supabase);
  recoveryReady = Boolean(user);
}

if (Astro.request.method === 'POST') {
  const limiter = await readAuthRateLimiter();
  const limited = await enforceAuthRateLimit({
    request: Astro.request,
    limiter,
    bucket: 'reset',
  });
  if (limited) return limited;

  const origin = requestSiteOrigin(Astro.request, Astro.url);
  if (!isSameOriginMutation(Astro.request, origin)) {
    return new Response('Invalid request origin.', {
      status: 403,
      headers: {
        'Content-Type': 'text/plain; charset=utf-8',
        'Cache-Control': 'private, no-store',
      },
    });
  }

  if (!supabase || !recoveryReady) {
    errorMessage = 'This reset link is invalid or has expired. Request a new one.';
  } else {
    const form = await Astro.request.formData();
    const parsed = resetPasswordSchema.safeParse({
      password: String(form.get('password') ?? ''),
      confirmPassword: String(form.get('confirmPassword') ?? ''),
    });

    if (!parsed.success) {
      errorMessage = parsed.error.issues[0]?.message || 'Unable to update password.';
    } else {
      const { error } = await supabase.auth.updateUser({
        password: parsed.data.password,
      });
      if (error) {
        logStudioAuthEvent('password_change_error', { message: error.message });
        errorMessage = 'Unable to update password. Try again or request a new link.';
      } else {
        const context = await getStudioAuthContext(supabase);
        await recordAuthActivity(supabase, {
          actorProfileId: context?.profile.id ?? null,
          action: 'auth.password_changed',
          metadata: sanitizeAuthMetadata({ reason: 'recovery' }),
        });
        if (context && context.profile.status === 'active') {
          return Astro.redirect('/admin', 303);
        }
        return Astro.redirect('/admin/login', 303);
      }
    }
  }
}
---

<StudioAuthLayout title="Reset password" description="Choose a new Che Xu Studio password.">
  <h1>Reset password</h1>
  <p class="studio-auth-lede">
    Choose a long password or passphrase. Avoid reusing passwords from other sites.
  </p>

  <StudioRecoverySession client:load />

  {
    errorMessage && (
      <p class="studio-auth-error mt-6" role="alert">
        {errorMessage}
      </p>
    )
  }

  {
    recoveryReady ? (
      <form class="studio-auth-form" method="post" action="/admin/reset-password" novalidate>
        <div class="studio-auth-field">
          <label for="password">New password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            required
            minlength="8"
          />
        </div>
        <div class="studio-auth-field">
          <label for="confirmPassword">Confirm password</label>
          <input
            id="confirmPassword"
            name="confirmPassword"
            type="password"
            autocomplete="new-password"
            required
            minlength="8"
          />
        </div>
        <button type="submit" class="studio-action studio-action-primary w-full">
          Update password
        </button>
      </form>
    ) : (
      <p class="studio-auth-lede mt-6" role="status">
        Open the reset link from your email to continue. If the link is expired, request a new one.
      </p>
    )
  }

  <div class="studio-auth-links">
    <a href="/admin/forgot-password">Request a new link</a>
    <a href="/admin/login">Back to sign in</a>
  </div>
</StudioAuthLayout>
