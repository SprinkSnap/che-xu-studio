---
import StudioLayout from '../../../../layouts/StudioLayout.astro';
import StudioPageHeader from '../../../../components/studio/StudioPageHeader.astro';
import StudioPanel from '../../../../components/studio/StudioPanel.astro';
import StudioStatusBadge from '../../../../components/studio/StudioStatusBadge.astro';
import TemplateFormFields from '../../../../components/studio/templates/TemplateFormFields.astro';
import { requireStudioPermission } from '../../../../lib/auth/require';
import { isSameOriginMutation, requestSiteOrigin } from '../../../../lib/auth/origin';
import { getProposalTemplate } from '../../../../lib/proposals/queries';
import {
  archiveProposalTemplate,
  ProposalMutationError,
  updateProposalTemplate,
} from '../../../../lib/proposals/mutations';
import {
  formDataToObject,
  GENERIC_TEMPLATE_ERROR,
  templateWriteSchema,
  uuidParamSchema,
} from '../../../../lib/proposals/validation';
import type { TemplateFormValues } from '../../../../lib/proposals/types';

export const prerender = false;

const auth = await requireStudioPermission(Astro, 'studio.templates.manage');
const supabase = Astro.locals.studioSupabase;
if (!supabase) {
  return Astro.redirect('/admin/login');
}

const idParsed = uuidParamSchema.safeParse(Astro.params.id);
if (!idParsed.success) {
  return new Response('Not found', { status: 404 });
}
const templateId = idParsed.data;

let template = await getProposalTemplate(supabase, templateId);
if (!template) {
  return new Response('Not found', {
    status: 404,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'Cache-Control': 'private, no-store',
      'X-Robots-Tag': 'noindex, nofollow, noarchive',
    },
  });
}

function toValues(row: NonNullable<typeof template>): TemplateFormValues {
  return {
    name: row.name,
    description: row.description ?? '',
    introduction: row.introduction ?? '',
    projectOverview: row.project_overview ?? '',
    objectives: row.objectives ?? '',
    scope: row.scope ?? '',
    deliverables: row.deliverables ?? '',
    timeline: row.timeline ?? '',
    paymentTerms: row.payment_terms ?? '',
    termsAndConditions: row.terms_and_conditions ?? '',
    notes: row.notes ?? '',
    makeDefault: row.is_default,
  };
}

let errorMessage = '';
let flashSuccess = '';
let values: TemplateFormValues = toValues(template);

const notice = Astro.url.searchParams.get('notice');
if (notice === 'created') flashSuccess = 'Template created.';
if (notice === 'saved') flashSuccess = 'Template saved.';
if (notice === 'archived') flashSuccess = 'Template archived.';
if (notice === 'default') flashSuccess = 'Default template updated.';

if (Astro.request.method === 'POST') {
  const origin = requestSiteOrigin(Astro.request, Astro.url);
  if (!isSameOriginMutation(Astro.request, origin)) {
    return new Response('Invalid request origin.', { status: 403 });
  }

  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');
  const actorId = auth.profile.id;

  if (intent === 'archive') {
    try {
      await archiveProposalTemplate(supabase, templateId, actorId);
      return Astro.redirect('/admin/templates?notice=archived', 303);
    } catch (error) {
      errorMessage =
        error instanceof ProposalMutationError ? error.message : GENERIC_TEMPLATE_ERROR;
    }
  } else if (template.is_archived) {
    errorMessage = 'Archived templates cannot be edited.';
  } else {
    const raw = formDataToObject(form);
    values = {
      name: raw.name ?? '',
      description: raw.description ?? '',
      introduction: raw.introduction ?? '',
      projectOverview: raw.projectOverview ?? '',
      objectives: raw.objectives ?? '',
      scope: raw.scope ?? '',
      deliverables: raw.deliverables ?? '',
      timeline: raw.timeline ?? '',
      paymentTerms: raw.paymentTerms ?? '',
      termsAndConditions: raw.termsAndConditions ?? '',
      notes: raw.notes ?? '',
      makeDefault: raw.makeDefault === 'on',
    };

    const parsed = templateWriteSchema.safeParse(raw);
    if (!parsed.success) {
      errorMessage = parsed.error.issues[0]?.message || GENERIC_TEMPLATE_ERROR;
    } else {
      try {
        await updateProposalTemplate(supabase, templateId, parsed.data, actorId);
        const noticeKey = parsed.data.makeDefault ? 'default' : 'saved';
        return Astro.redirect(`/admin/templates/${templateId}/edit?notice=${noticeKey}`, 303);
      } catch (error) {
        errorMessage =
          error instanceof ProposalMutationError ? error.message : GENERIC_TEMPLATE_ERROR;
      }
    }
  }

  template = (await getProposalTemplate(supabase, templateId)) ?? template;
}
---

<StudioLayout title={template.name} description="Edit proposal template.">
  <StudioPageHeader
    slot="header"
    title={template.name}
    description="Update template content or set it as the studio default."
  />
  <Fragment slot="actions">
    {
      !template.is_archived && (
        <form method="post" action={`/admin/templates/${template.id}/edit`}>
          <input type="hidden" name="intent" value="archive" />
          <button type="submit" class="studio-action" data-confirm-archive>
            Archive
          </button>
        </form>
      )
    }
    <a class="studio-action" href="/admin/templates">All templates</a>
  </Fragment>

  {
    flashSuccess && (
      <p class="studio-auth-success mb-6" role="status">
        {flashSuccess}
      </p>
    )
  }

  <div class="mb-6 flex flex-wrap items-center gap-3">
    {
      template.is_default && !template.is_archived && (
        <StudioStatusBadge label="Default" tone="success" />
      )
    }
    {
      template.is_archived && <StudioStatusBadge label="Archived" tone="neutral" />
    }
  </div>

  <StudioPanel title="Template details">
    {
      template.is_archived ? (
        <p class="text-sm text-ink-muted">
          This template is archived and can no longer be edited. Create a new template if you need
          updated content.
        </p>
      ) : (
        <form method="post" action={`/admin/templates/${template.id}/edit`} novalidate>
          <input type="hidden" name="intent" value="save" />
          <TemplateFormFields values={values} mode="edit" errorMessage={errorMessage} />
          <div class="studio-actions mt-2">
            <button type="submit" class="studio-action studio-action-primary">
              Save template
            </button>
            <a class="studio-action" href="/admin/templates">Cancel</a>
          </div>
        </form>
      )
    }
  </StudioPanel>
</StudioLayout>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-confirm-archive]').forEach((button) => {
      button.addEventListener('click', (event) => {
        if (!confirm('Archive this template? It will no longer appear for new proposals.')) {
          event.preventDefault();
        }
      });
    });
  })();
</script>
