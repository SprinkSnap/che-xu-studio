---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

/**
 * Legacy marketing checkout cancelled route.
 * Invoice cancel UX returns to /invoice/[token]?payment=cancelled.
 */
---

<BaseLayout
  title="Checkout cancelled"
  description="No payment was completed. Return to your invoice link or contact Che Xu Studio."
  path="/checkout/cancelled"
  noindex={true}
  showMobileCta={false}
>
  <section class="section">
    <div class="container-shell max-w-2xl">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Checkout', href: '/contact' },
          { name: 'Cancelled' },
        ]}
      />
      <h1 class="font-display text-4xl font-bold text-navy-900">No checkout was completed</h1>
      <p class="lead mt-4">
        If you started paying a Studio invoice, return to your secure invoice link to try again.
        Cancelling checkout does not change invoice payment status.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="btn-primary">Contact the studio</a>
        <a href="/" class="btn-secondary">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
