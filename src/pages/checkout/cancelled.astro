---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheckoutHost from '../../components/CheckoutHost.astro';
import { getPackageById } from '../../config/packages';

const planId = Astro.url.searchParams.get('plan') || '';
const pkg = planId ? getPackageById(planId) : undefined;
---

<BaseLayout
  title="Checkout cancelled"
  description="Your Che Xu Studio checkout was cancelled. No charge was completed."
  path="/checkout/cancelled"
  noindex={true}
  showMobileCta={false}
>
  <section class="section">
    <div class="container-shell max-w-2xl">
      <div class="surface-card p-8">
        <h1 class="font-display text-3xl font-bold text-navy-900">Checkout cancelled</h1>
        <p class="mt-4 text-ink-muted">
          No problem—nothing was charged.
          {pkg ? <> You can restart checkout for <strong>{pkg.name}</strong> whenever you’re ready.</> : null}
        </p>
        <p class="mt-3 text-sm text-ink-muted">
          Prefer a quote or a conversation first? We’re happy to help without pressure.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          {pkg && (
            <button type="button" class="btn-primary" data-checkout-open={pkg.id}>
              Resume {pkg.shortName}
            </button>
          )}
          <a href="/pricing" class="btn-secondary">Compare packages</a>
          <a href="/contact" class="btn-secondary">Talk to us</a>
        </div>
      </div>
    </div>
  </section>
  <CheckoutHost />
</BaseLayout>
