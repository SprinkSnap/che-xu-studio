---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { retrieveCheckoutSession } from '../../lib/stripe';
import { getPackageById } from '../../config/packages';
import { getOrderBySession } from '../../lib/db';

export const prerender = false;

const sessionId = Astro.url.searchParams.get('session_id');
let verified = false;
let packageName = '';
let email = '';
let statusLabel = 'unverified';

if (sessionId && env.STRIPE_SECRET_KEY) {
  const session = await retrieveCheckoutSession(env.STRIPE_SECRET_KEY, sessionId);
  if (session && (session.payment_status === 'paid' || session.status === 'complete')) {
    verified = true;
    statusLabel = session.payment_status || session.status || 'complete';
    email = session.customer_details?.email || session.customer_email || '';
    const planId = session.metadata?.planId;
    packageName = (planId && getPackageById(planId)?.name) || session.metadata?.packageName || 'your package';

    try {
      if (env.DB) {
        await getOrderBySession(env.DB, session.id);
      }
    } catch {
      // non-fatal
    }
  }
}
---

<BaseLayout
  title={verified ? 'Checkout confirmed' : 'Checkout verification'}
  description="Stripe checkout confirmation for Che Xu Studio."
  path="/checkout/success"
  noindex={true}
  showMobileCta={false}
>
  <section class="section">
    <div class="container-shell max-w-2xl">
      {
        verified ? (
          <div class="surface-card p-8" data-track="checkout_completed_verified">
            <p class="eyebrow">Payment verified</p>
            <h1 class="mt-3 font-display text-4xl font-bold text-navy-900">Thank you — you’re confirmed</h1>
            <p class="mt-4 text-ink-muted">
              Your Stripe Checkout session was verified server-side for <strong>{packageName}</strong>
              {email ? <> ({email})</> : null}. Status: {statusLabel}.
            </p>
            <p class="mt-4 text-sm text-ink-muted">
              What happens next: we’ll follow up by email with onboarding details or subscription confirmation. Keep your Stripe receipt for your records.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/contact" class="btn-primary">Ask a follow-up question</a>
              <a href="/" class="btn-secondary">Back to home</a>
            </div>
            <script is:inline>
              window.__cxTrack && window.__cxTrack({ event: 'checkout_completed_verified' });
            </script>
          </div>
        ) : (
          <div class="surface-card p-8">
            <h1 class="font-display text-3xl font-bold text-navy-900">We couldn’t verify this checkout</h1>
            <p class="mt-4 text-ink-muted">
              This page only confirms orders after Stripe session verification. If you completed payment, check your email for a Stripe receipt or contact us with the time of purchase—do not resubmit payment unless asked.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/contact" class="btn-primary">Contact support</a>
              <a href="/pricing" class="btn-secondary">Return to pricing</a>
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
