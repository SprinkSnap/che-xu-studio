---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/react/ContactForm';
import FaqSection from '../components/FaqSection.astro';
import { siteConfig } from '../config/site';
import { faqsForPage } from '../config/faq';
import { breadcrumbSchema, faqPageSchema } from '../lib/seo';
import { resolvePublicTurnstileSiteKey } from '../lib/public-config';
import { env } from 'cloudflare:workers';

const faqItems = faqsForPage('contact');
const turnstileSiteKey = resolvePublicTurnstileSiteKey({
  runtime: env.PUBLIC_TURNSTILE_SITE_KEY,
  build: import.meta.env.PUBLIC_TURNSTILE_SITE_KEY,
});
const initialPlan = Astro.url.searchParams.get('plan') || undefined;
const initialIntent = Astro.url.searchParams.get('intent') || undefined;
---

<BaseLayout
  title="Get a Project Quote"
  description="Request a web design, SEO, or website care quote from Che Xu Studio. Share your goals—no obligation to purchase. Clear next steps after you submit."
  path="/contact"
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ]),
    faqPageSchema(faqItems),
  ]}
>
  <section class="section">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Contact' }]} />
        <p class="eyebrow">Contact</p>
        <h1 class="mt-3 font-display text-4xl font-bold text-navy-900 sm:text-5xl">
          Get a project quote
        </h1>
        <p class="lead mt-4">
          Tell us what you need. We’ll help you choose the right package—or prepare an exact quote. Submitting this form does not obligate you to purchase.
        </p>
        <div class="mt-6 space-y-3 text-sm text-ink-muted">
          <p>
            <strong class="text-navy-900">What happens next:</strong> we review your goals, confirm fit, and reply by email with clear next steps. If you share a phone number and prefer a call, we may follow up that way.
          </p>
          <p>
            <strong class="text-navy-900">Helpful to include:</strong> your business type, current website (if any), primary goal, and rough timeline. Use the optional project brief for more detail.
          </p>
          {
            siteConfig.contact.email && (
              <p>
                Email:{' '}
                <a class="font-semibold text-blue-500" href={`mailto:${siteConfig.contact.email}`}>
                  {siteConfig.contact.email}
                </a>
              </p>
            )
          }
          {
            siteConfig.contact.phone && (
              <p>
                Phone:{' '}
                <a class="font-semibold text-blue-500" href={`tel:${siteConfig.contact.phone}`}>
                  {siteConfig.contact.phoneDisplay || siteConfig.contact.phone}
                </a>
              </p>
            )
          }
          {
            siteConfig.contact.bookingUrl && (
              <p>
                <a class="btn-secondary mt-2 inline-flex" href={siteConfig.contact.bookingUrl}>
                  Book a free strategy call
                </a>
              </p>
            )
          }
          <p>
            Prefer to compare packages first?{' '}
            <a class="font-semibold text-blue-500 underline" href="/pricing">View pricing</a>
            {' '}or{' '}
            <a class="font-semibold text-blue-500 underline" href="/#package-finder">use the package finder</a>.
          </p>
        </div>
      </div>

      <ContactForm
        client:visible
        turnstileSiteKey={turnstileSiteKey}
        contactEmail={siteConfig.contact.email}
        initialPlan={initialPlan}
        initialIntent={initialIntent}
      />
    </div>
  </section>

  <FaqSection items={faqItems} />
</BaseLayout>
