---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProjects, siteConfig } from '../config/site';
import OutcomeCards from '../components/OutcomeCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import PricingCard from '../components/PricingCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FaqSection from '../components/FaqSection.astro';
import FinalCta from '../components/FinalCta.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import PackageFinder from '../components/react/PackageFinder';
import { packages } from '../config/packages';
import { faqsForPage } from '../config/faq';
import { faqPageSchema, offerCatalogSchema } from '../lib/seo';

const featured = packages.filter((p) =>
  ['brand-identity', 'custom-seo-launch', 'seo-growth', 'website-care'].includes(p.id),
);
const faqItems = faqsForPage('home');
const homepageProjects = featuredProjects(3);
---

<BaseLayout
  title="Conversion-Focused Web Design & SEO for Canadian Small Businesses"
  description="Che Xu Studio builds conversion-focused websites and practical SEO for Canadian small businesses—clear CAD pricing, mobile-first delivery, and a direct path to qualified enquiries."
  path="/"
  schema={[offerCatalogSchema(), faqPageSchema(faqItems)]}
>
  <!-- Trust strip -->
  <div class="border-b border-white/10 bg-navy-950">
    <div class="container-shell flex min-h-10 items-center justify-center py-2 text-center text-xs font-medium tracking-wide text-blue-100 sm:text-sm">
      {siteConfig.trustStrip}
    </div>
  </div>

  <!-- Hero -->
  <section class="hero-plane relative overflow-hidden text-white">
    <div class="container-shell relative grid items-center gap-10 py-12 sm:py-16 lg:min-h-[min(78vh,720px)] lg:grid-cols-[1.1fr_0.9fr] lg:py-20">
      <div class="reveal max-w-2xl">
        <p class="eyebrow !text-blue-300">Web Design & SEO for Canadian Small Businesses</p>
        <h1 class="mt-4 font-display text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
          Websites that win more qualified enquiries.
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-blue-100/90 sm:text-lg">
          Che Xu Studio designs fast, conversion-focused websites and SEO foundations for Canadian small and growing businesses—so customers can find you and take action.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={siteConfig.cta.primary.href}
            class="btn btn-primary-on-dark"
            data-track="hero_cta_selected"
            onclick="window.__cxTrack && window.__cxTrack({ event: 'hero_cta_selected', props: { cta: 'quote' } })"
          >
            {siteConfig.cta.primary.label}
          </a>
          <a
            href={siteConfig.cta.secondary.href}
            class="btn-secondary border-white/20 bg-white/10 text-white hover:bg-white/15"
            data-track="hero_cta_selected"
            onclick="window.__cxTrack && window.__cxTrack({ event: 'hero_cta_selected', props: { cta: 'finder' } })"
          >
            {siteConfig.cta.secondary.label}
          </a>
        </div>
        <p class="mt-5 text-sm text-blue-100/80">
          Clear CAD pricing · Direct communication · Mobile-first · SEO foundations included where applicable
        </p>
      </div>

      <div class="reveal reveal-delay-2 relative hidden lg:block" aria-hidden="true">
        <div class="absolute inset-0 rounded-[var(--radius-xl)] bg-gradient-to-br from-blue-400/20 via-purple-500/10 to-transparent"></div>
        <div class="relative overflow-hidden rounded-[var(--radius-xl)] border border-white/15 bg-white/5 p-6 backdrop-blur-sm">
          <p class="font-display text-2xl font-bold">{siteConfig.name}</p>
          <p class="mt-2 text-sm text-blue-100/85">{siteConfig.supportingMessage}</p>
          <dl class="mt-8 space-y-4">
            <div class="rounded-lg border border-white/10 bg-navy-950/40 p-4">
              <dt class="text-xs uppercase tracking-[0.14em] text-blue-300">Web Design</dt>
              <dd class="mt-1 text-sm text-blue-50">Custom builds focused on conversion & launch</dd>
            </div>
            <div class="rounded-lg border border-white/10 bg-navy-950/40 p-4">
              <dt class="text-xs uppercase tracking-[0.14em] text-green-100">SEO Strategy</dt>
              <dd class="mt-1 text-sm text-blue-50">Launch foundations & monthly growth plans</dd>
            </div>
            <div class="rounded-lg border border-white/10 bg-navy-950/40 p-4">
              <dt class="text-xs uppercase tracking-[0.14em] text-gold-100">Website Care</dt>
              <dd class="mt-1 text-sm text-blue-50">Monitoring, security, performance, and support</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <OutcomeCards />

  <!-- Services overview -->
  <section class="section bg-surface-muted" aria-labelledby="services-heading">
    <div class="container-shell">
      <SectionHeading
        id="services-heading"
        eyebrow="Services"
        title="Web design, branding, SEO, and care—connected to growth"
        lead="Choose a focused engagement or combine brand, launch, and growth when your business is ready."
      />
      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
        <a
          href="/services/branding"
          class="surface-card accent-blue block p-6 transition hover:shadow-lift"
          onclick="window.__cxTrack && window.__cxTrack({ event: 'service_cta_selected', props: { service: 'branding', source: 'home_cards' } })"
        >
          <h3 class="font-display text-2xl font-bold text-navy-900">Branding</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">
            Logo and brand identity systems that keep your look consistent across web and marketing.
          </p>
          <span class="mt-5 inline-flex text-sm font-semibold text-blue-500">Explore branding →</span>
        </a>
        <a
          href="/services/web-design"
          class="surface-card accent-purple block p-6 transition hover:shadow-lift"
          onclick="window.__cxTrack && window.__cxTrack({ event: 'service_cta_selected', props: { service: 'web-design', source: 'home_cards' } })"
        >
          <h3 class="font-display text-2xl font-bold text-navy-900">Web Design</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">
            Custom websites built from scratch to convert—not just look finished.
          </p>
          <span class="mt-5 inline-flex text-sm font-semibold text-purple-600">Explore web design →</span>
        </a>
        <a
          href="/services/seo"
          class="surface-card accent-green block p-6 transition hover:shadow-lift"
          onclick="window.__cxTrack && window.__cxTrack({ event: 'service_cta_selected', props: { service: 'seo', source: 'home_cards' } })"
        >
          <h3 class="font-display text-2xl font-bold text-navy-900">SEO Strategy</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">
            Launch SEO foundations and ongoing SEO & conversion growth with clear reporting—no ranking promises.
          </p>
          <span class="mt-5 inline-flex text-sm font-semibold text-green-600">Explore SEO strategy →</span>
        </a>
        <a
          href="/services/website-care"
          class="surface-card accent-gold block p-6 transition hover:shadow-lift"
          onclick="window.__cxTrack && window.__cxTrack({ event: 'service_cta_selected', props: { service: 'website-care', source: 'home_cards' } })"
        >
          <h3 class="font-display text-2xl font-bold text-navy-900">Website Care</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">
            Monitoring, maintenance, security, performance, and priority support so your site stays reliable.
          </p>
          <span class="mt-5 inline-flex text-sm font-semibold text-gold-600">Explore website care →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Package finder -->
  <section id="package-finder" class="section" aria-labelledby="finder-heading">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <SectionHeading
        id="finder-heading"
        eyebrow="Package finder"
        title="Not sure where to start?"
        lead="Answer a few guided questions and get one clear recommendation—with every package still available to compare."
      />
      <PackageFinder client:visible />
    </div>
  </section>

  <!-- Featured packages -->
  <section class="section bg-surface-muted" aria-labelledby="pricing-heading">
    <div class="container-shell">
      <SectionHeading
        id="pricing-heading"
        eyebrow="Pricing"
        title="Featured packages with transparent starting prices"
        lead="All prices are in CAD. “Starting at” means a typical scope—your exact quote is confirmed before any fixed charge."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {featured.map((pkg) => <PricingCard pkg={pkg} />)}
      </div>
      <div class="mt-8">
        <a href="/pricing" class="btn-secondary">Compare all five packages</a>
      </div>
    </div>
  </section>

  <ProcessSteps />

  <!-- Featured work -->
  <section class="section bg-surface-muted" aria-labelledby="work-heading">
    <div class="container-shell">
      {
        homepageProjects.length > 0 ? (
          <>
            <SectionHeading
              id="work-heading"
              eyebrow="Work"
              title="Selected portfolio concepts"
              lead="Concept projects that demonstrate conversion-focused design and SEO. Verified client work is published separately when approved."
            />
            <div class="mt-10 grid gap-5 lg:grid-cols-3">
              {homepageProjects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
            <div class="mt-8">
              <a href="/work" class="btn-secondary">View all work</a>
            </div>
          </>
        ) : (
          <>
            <SectionHeading
              id="work-heading"
              eyebrow="Delivery standards"
              title="What every project includes"
              lead="Until verified case studies are published, here is the baseline you can expect from Che Xu Studio."
            />
            <ul class="mt-10 grid gap-4 sm:grid-cols-2">
              {[
                'Mobile-first layouts that prioritize the primary customer action',
                'Clear scope summaries before build or subscription work begins',
                'Performance-minded implementation and sensible SEO foundations',
                'Launch support and plain-language next-step guidance',
                'Transparent starting prices in CAD with written confirmations for fixed fees',
                'A human path to ask questions—never pressure tactics or fake urgency',
              ].map((item) => (
                <li class="rounded-[var(--radius-lg)] border border-border bg-white p-5 text-sm leading-relaxed text-ink">
                  {item}
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>

  <!-- Why Che Xu Studio -->
  <section class="section" aria-labelledby="why-heading">
    <div class="container-shell grid gap-10 lg:grid-cols-2 lg:items-center">
      <SectionHeading
        id="why-heading"
        eyebrow="Why Che Xu Studio"
        title="Clear process. Honest scope. Practical delivery."
        lead="You work directly with the person designing and building your website—with transparent pricing and no manufactured urgency."
      />
      <ul class="space-y-4">
        {[
          {
            t: 'Direct collaboration',
            d: 'Work with the designer-developer responsible for your site—not a handoff chain of accounts and freelancers.',
          },
          {
            t: 'Transparent CAD pricing',
            d: 'Published starting prices, package finder guidance, and scope confirmed in writing before invoicing.',
          },
          {
            t: 'Conversion + SEO foundations',
            d: 'Mobile-first layouts, clear next actions, and search foundations where the package includes them—without ranking guarantees.',
          },
          {
            t: 'Human when you need it',
            d: 'Use the AI assistant for quick answers, or send a quote request when you want a person.',
          },
        ].map((item) => (
          <li class="rounded-[var(--radius-lg)] border border-border bg-white p-5 shadow-soft">
            <h3 class="font-semibold text-navy-900">{item.t}</h3>
            <p class="mt-1 text-sm text-ink-muted">{item.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FaqSection items={faqItems} />
  <FinalCta />
</BaseLayout>
