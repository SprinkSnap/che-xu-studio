---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../../lib/seo';

const entries = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Insights"
  description="Che Xu Studio insights on web design, SEO, and website care. Published only when substantive content is ready."
  path="/insights"
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Insights', path: '/insights' },
    ]),
  ]}
>
  <section class="section">
    <div class="container-shell max-w-3xl">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Insights' }]} />
      <h1 class="font-display text-4xl font-bold text-navy-900">Insights</h1>
      <p class="lead mt-4">
        This collection is ready for owner-approved articles. We do not publish thin filler content.
      </p>

      {
        entries.length === 0 ? (
          <div class="mt-10 rounded-[var(--radius-lg)] border border-border bg-surface-muted p-6">
            <h2 class="font-display text-2xl font-bold text-navy-900">No articles published yet</h2>
            <p class="mt-3 text-sm text-ink-muted">
              Add Markdown files under <code class="rounded bg-white px-1.5 py-0.5 text-xs">src/content/insights/</code> with
              <code class="rounded bg-white px-1.5 py-0.5 text-xs">draft: false</code> when ready.
            </p>
          </div>
        ) : (
          <ul class="mt-10 space-y-4">
            {entries.map((entry) => (
              <li class="surface-card p-5">
                <a href={`/insights/${entry.id}`} class="font-display text-2xl font-bold text-navy-900 hover:text-blue-500">
                  {entry.data.title}
                </a>
                <p class="mt-2 text-sm text-ink-muted">{entry.data.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
