---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PricingCard from '../../components/PricingCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FaqSection from '../../components/FaqSection.astro';
import FinalCta from '../../components/FinalCta.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { packages } from '../../config/packages';
import { featuredProjects, siteConfig } from '../../config/site';
import { faqsForPage } from '../../config/faq';
import { breadcrumbSchema, faqPageSchema, serviceSchema } from '../../lib/seo';

const webPackages = packages.filter((p) => p.category === 'web-design');
const faqItems = faqsForPage('web-design');
const relatedProjects = featuredProjects(3);
---

<BaseLayout
  title="Custom Web Design for Canadian Small Businesses"
  description="Custom-built, conversion-focused websites from Che Xu Studio—designed from scratch for Canadian small businesses, with clear CAD starting prices and optional SEO launch."
  path="/services/web-design"
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Web Design', path: '/services/web-design' },
    ]),
    serviceSchema({
      name: 'Custom Web Design for Canadian Small Businesses',
      description:
        'Custom websites built from scratch with conversion-focused structure, performance, accessibility, and SEO readiness for Canadian small businesses.',
      path: '/services/web-design',
    }),
    faqPageSchema(faqItems),
  ]}
>
  <section class="hero-plane text-white">
    <div class="container-shell section !pb-16 !pt-12">
      <Breadcrumbs
        tone="dark"
        items={[
          { name: 'Home', href: '/' },
          { name: 'Services', href: '/services/web-design' },
          { name: 'Web Design' },
        ]}
      />
      <p class="eyebrow !text-blue-300">Web Design</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold sm:text-5xl">
        Web design that makes the next step obvious.
      </h1>
      <p class="mt-5 max-w-2xl text-base text-blue-100/90 sm:text-lg">
        For Canadian small and growing businesses that need a custom website visitors can
        understand—and act on—quickly. Built from scratch for conversion, performance,
        accessibility, and SEO readiness, with full SEO launch when your package includes it.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={siteConfig.cta.primary.href}
          class="btn btn-primary-on-dark"
          onclick="window.__cxTrack && window.__cxTrack({ event: 'service_cta_selected', props: { service: 'web-design', cta: 'quote' } })"
        >
          {siteConfig.cta.primary.label}
        </a>
        <a
          href="/pricing"
          class="btn-secondary border-white/20 bg-white/10 text-white hover:bg-white/15"
        >
          View web design packages
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="who-heading">
    <div class="container-shell grid gap-10 lg:grid-cols-2">
      <SectionHeading
        id="who-heading"
        title="Who this is for"
        lead="Owners and operators who want a professional custom site without agency fluff—or vague “brand elevation” language."
      />
      <ul class="space-y-3 text-sm leading-relaxed text-ink-muted sm:text-base">
        <li>Local and service businesses that need more quote requests, bookings, or calls</li>
        <li>Growing companies replacing an outdated site that does not convert on mobile</li>
        <li>Teams that want a custom build—not an off-the-shelf commercial theme</li>
        <li>Businesses that want SEO foundations included at launch when the budget allows</li>
      </ul>
    </div>
  </section>

  <section class="section bg-surface-muted" aria-labelledby="problems-heading">
    <div class="container-shell">
      <SectionHeading
        id="problems-heading"
        title="Problems a conversion-focused site solves"
        lead="Pretty is not enough. Your site should reduce friction between interest and enquiry."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          [
            {
              title: 'Unclear offer',
              body: 'Visitors leave when they cannot tell what you do, who you help, or what to do next.',
            },
            {
              title: 'Weak mobile experience',
              body: 'Most Canadian small-business traffic is mobile. Slow layouts and buried CTAs cost enquiries.',
            },
            {
              title: 'Weak search foundations',
              body: 'Without structure, metadata, and crawlable content, good design still struggles to get found.',
            },
          ].map((item) => (
            <article class="surface-card p-6">
              <h3 class="font-display text-xl font-bold text-navy-900">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="paths-heading">
    <div class="container-shell">
      <SectionHeading
        id="paths-heading"
        title="Two website paths"
        lead="Choose the path that matches your SEO priority. Both are custom builds—not commercial themes."
      />
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {
          [
            {
              title: 'Custom Website — Built From Scratch',
              body: 'A fast, conversion-focused website designed and developed specifically for your business—custom UI/UX, responsive development, performance, accessibility, SEO-ready architecture, and professional launch.',
            },
            {
              title: 'Custom Website + SEO Launch',
              body: 'Everything in Custom Website plus keyword research, technical SEO, on-page setup, tracking, local SEO where relevant, and 30-day post-launch SEO support. Our Most Popular / flagship offer.',
            },
          ].map((item) => (
            <article class="surface-card p-6">
              <h3 class="font-display text-2xl font-bold text-navy-900">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-surface-muted" aria-labelledby="approach-heading">
    <div class="container-shell grid gap-10 lg:grid-cols-2">
      <SectionHeading
        id="approach-heading"
        title="How Che Xu Studio approaches web design"
        lead="Practical decisions that help visitors enquire—not speculative redesigns for their own sake."
      />
      <ul class="space-y-4 text-sm leading-relaxed text-ink-muted sm:text-base">
        <li>
          <strong class="text-navy-900">Custom design:</strong> layouts and UI built for your offers and
          customer journey—without relying on an off-the-shelf commercial theme.
        </li>
        <li>
          <strong class="text-navy-900">Conversion-focused structure:</strong> clear headlines, service
          clarity, and primary CTAs above the fold on mobile.
        </li>
        <li>
          <strong class="text-navy-900">Performance & accessibility:</strong> fast, usable experiences
          with accessible implementation as a baseline.
        </li>
        <li>
          <strong class="text-navy-900">SEO readiness & maintainability:</strong> semantic structure,
          metadata, and a launch setup that is secure and easier to maintain over time.
        </li>
        <li>
          <strong class="text-navy-900">Scope before invoicing:</strong> starting prices in CAD, with
          written confirmation before fixed project fees.
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="process-heading">
    <div class="container-shell">
      <SectionHeading
        id="process-heading"
        title="Project process"
        lead="Typical timelines assume timely feedback and content readiness. Exact dates are confirmed after scope review."
      />
      <ol class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {
          [
            { t: 'Discovery', d: 'Goals, audience, offers, and package fit.' },
            { t: 'Design & build', d: 'Custom UI/UX, mobile-first layouts, and development.' },
            { t: 'Review', d: 'Revision window, accessibility checks, and launch prep.' },
            { t: 'Launch', d: 'Go-live support plus SEO launch items when included.' },
          ].map((step, index) => (
            <li class="rounded-[var(--radius-lg)] border border-border bg-white p-5 shadow-soft">
              <span class="mb-3 inline-flex h-9 w-9 items-center justify-center rounded-md bg-navy-900 text-sm font-bold text-white">
                {index + 1}
              </span>
              <h3 class="font-display text-xl font-bold text-navy-900">{step.t}</h3>
              <p class="mt-2 text-sm text-ink-muted">{step.d}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-sm text-ink-muted">
        Typical ranges from package config: Custom Website 6–10 weeks · Custom Website + SEO Launch
        8–12 weeks. Domain, DNS and SSL launch setup included; domain registration and renewal fees
        are paid separately by the client.
      </p>
    </div>
  </section>

  {
    relatedProjects.length > 0 && (
      <section class="section bg-surface-muted" aria-labelledby="examples-heading">
        <div class="container-shell">
          <SectionHeading
            id="examples-heading"
            title="Relevant portfolio concepts"
            lead="Concept projects that show conversion-focused service and hospitality experiences—not invented client metrics."
          />
          <div class="mt-10 grid gap-5 lg:grid-cols-3">
            {relatedProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
          <div class="mt-8">
            <a href="/work" class="btn-secondary">
              Browse all work
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="packages-heading">
    <div class="container-shell">
      <SectionHeading
        id="packages-heading"
        title="Web design packages"
        lead="Starting prices in CAD. Final project quotes are confirmed in writing. Custom Website + SEO Launch is the flagship / Most Popular offer."
      />
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {webPackages.map((pkg) => <PricingCard pkg={pkg} />)}
      </div>
      <p class="mt-8 text-sm text-ink-muted">
        Need a logo and brand system first?
        <a class="font-semibold text-blue-500 underline" href="/services/branding"
          >Explore branding</a
        >. Prefer guidance first? Use the
        <a class="font-semibold text-blue-500 underline" href="/#package-finder">package finder</a>
        or
        <a class="font-semibold text-blue-500 underline" href="/pricing">compare all packages</a>.
      </p>
    </div>
  </section>

  <FaqSection items={faqItems} />
  <FinalCta />
</BaseLayout>
