---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PricingCard from '../../components/PricingCard.astro';
import FaqSection from '../../components/FaqSection.astro';
import FinalCta from '../../components/FinalCta.astro';
import CheckoutHost from '../../components/CheckoutHost.astro';
import { packages } from '../../config/packages';
import { faqsForPage } from '../../config/faq';
import { breadcrumbSchema, faqPageSchema, serviceSchema } from '../../lib/seo';

const care = packages.find((p) => p.id === 'website-care')!;
const faqItems = faqsForPage('website-care');
---

<BaseLayout
  title="Website Care & Maintenance"
  description="WordPress updates, backups, security monitoring, and priority support starting at CAD $199/month."
  path="/services/website-care"
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Website Care', path: '/services/website-care' },
    ]),
    serviceSchema({
      name: 'Website Care & Maintenance',
      description: 'Ongoing WordPress maintenance, security, backups, and priority support.',
      path: '/services/website-care',
    }),
    faqPageSchema(faqItems),
  ]}
>
  <section class="hero-plane text-white">
    <div class="container-shell section !pb-16 !pt-12">
      <Breadcrumbs tone="dark" items={[{ name: 'Home', href: '/' }, { name: 'Website Care' }]} />
      <p class="eyebrow !text-gold-100">Website Care</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold sm:text-5xl">
        Stay online, updated, and secure.
      </h1>
      <p class="mt-5 max-w-2xl text-base text-blue-100/90 sm:text-lg">
        Proactive WordPress care for businesses that want fewer surprises—updates, backups, monitoring, and priority issue resolution.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <button type="button" class="btn btn-primary-on-dark" data-checkout-open={care.id}>Start Website Care</button>
        <a href="/contact" class="btn-secondary border-white/20 bg-white/10 text-white hover:bg-white/15">
          Ask about your stack
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-shell max-w-3xl">
      <PricingCard pkg={care} />
      <p class="mt-6 text-sm text-ink-muted">
        Hosting fees are separate unless otherwise agreed in writing. Cancel anytime according to the
        <a class="font-semibold text-blue-500 underline" href="/refund-cancellation-policy">cancellation policy</a>.
      </p>
    </div>
  </section>

  <FaqSection items={faqItems} />
  <FinalCta />
  <CheckoutHost />
</BaseLayout>
