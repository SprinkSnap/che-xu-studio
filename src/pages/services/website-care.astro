---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PricingCard from '../../components/PricingCard.astro';
import FaqSection from '../../components/FaqSection.astro';
import FinalCta from '../../components/FinalCta.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { packages, quoteContactHref } from '../../config/packages';
import { siteConfig } from '../../config/site';
import { faqsForPage } from '../../config/faq';
import { breadcrumbSchema, faqPageSchema, serviceSchema } from '../../lib/seo';

const care = packages.find((p) => p.id === 'website-care')!;
const faqItems = faqsForPage('website-care');
---

<BaseLayout
  title="Website Care & Maintenance"
  description="Proactive website care from Che Xu Studio—monitoring, maintenance, security, performance, and priority support for custom websites. Starting at CAD $199/month."
  path="/services/website-care"
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Website Care', path: '/services/website-care' },
    ]),
    serviceSchema({
      name: 'Website Care & Maintenance',
      description:
        'Ongoing monitoring, maintenance, security, performance checks, and priority technical support for custom websites.',
      path: '/services/website-care',
    }),
    faqPageSchema(faqItems),
  ]}
>
  <section class="hero-plane text-white">
    <div class="container-shell section !pb-16 !pt-12">
      <Breadcrumbs tone="dark" items={[{ name: 'Home', href: '/' }, { name: 'Website Care' }]} />
      <p class="eyebrow !text-gold-100">Website Care</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold sm:text-5xl">
        Stay online, secure, and reliable.
      </h1>
      <p class="mt-5 max-w-2xl text-base text-blue-100/90 sm:text-lg">
        Proactive website care for Canadian small businesses that want fewer surprises—monitoring, maintenance, security, performance, and priority technical support after launch.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={quoteContactHref(care.id)}
          class="btn btn-primary-on-dark"
          onclick="window.__cxTrack && window.__cxTrack({ event: 'service_cta_selected', props: { service: 'website-care', cta: 'quote' } })"
        >
          Request This Plan
        </a>
        <a href={siteConfig.cta.secondary.href} class="btn-secondary border-white/20 bg-white/10 text-white hover:bg-white/15">
          {siteConfig.cta.secondary.label}
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="care-who-heading">
    <div class="container-shell grid gap-10 lg:grid-cols-2">
      <SectionHeading
        id="care-who-heading"
        title="Who Website Care is for"
        lead="Businesses with a custom website that want maintenance handled without dark-pattern lock-ins."
      />
      <ul class="space-y-3 text-sm leading-relaxed text-ink-muted sm:text-base">
        <li>Owners who want deployment, uptime, and security monitoring handled</li>
        <li>Teams that need dependency and security updates where applicable</li>
        <li>Sites that need bug fixes and priority support when something breaks</li>
        <li>Businesses that want a monthly plan they can cancel per the published policy</li>
      </ul>
    </div>
  </section>

  <section class="section bg-surface-muted" aria-labelledby="care-includes-heading">
    <div class="container-shell">
      <SectionHeading
        id="care-includes-heading"
        title="What’s included"
        lead="Based on the Website Care & Maintenance package—hosting fees remain separate unless agreed in writing."
      />
      <ul class="mt-10 grid gap-3 sm:grid-cols-2">
        {care.includes.map((item) => (
          <li class="rounded-[var(--radius-lg)] border border-border bg-white p-4 text-sm text-ink">
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="care-package-heading">
    <div class="container-shell max-w-3xl">
      <SectionHeading
        id="care-package-heading"
        title="Website Care package"
        lead="Starting at CAD $199/month. Request the plan through the contact form; payment details are confirmed in writing."
      />
      <div class="mt-8">
        <PricingCard pkg={care} />
      </div>
      <p class="mt-6 text-sm text-ink-muted">
        Hosting fees are separate unless otherwise agreed in writing. Cancel anytime according to the
        <a class="font-semibold text-blue-500 underline" href="/refund-cancellation-policy">cancellation policy</a>.
        Looking for a new site first?
        <a class="font-semibold text-blue-500 underline" href="/services/web-design">Explore web design</a>
        or
        <a class="font-semibold text-blue-500 underline" href="/pricing">compare packages</a>.
      </p>
    </div>
  </section>

  <FaqSection items={faqItems} />
  <FinalCta />
</BaseLayout>
