---
/**
 * SSR so /work is not served from a long-lived static Assets CDN object.
 * Demo CTA hrefs change in site config and must show up immediately after deploy.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalCta from '../components/FinalCta.astro';
import { isExternalProjectHref, siteConfig } from '../config/site';
import { breadcrumbSchema } from '../lib/seo';

const projects = siteConfig.projects;
---

<BaseLayout
  title="Work"
  description="Che Xu Studio portfolio concepts and verified projects. Empty sections stay hidden until items are added in site config."
  path="/work"
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Work', path: '/work' },
    ]),
  ]}
>
  <section class="section">
    <div class="container-shell">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Work' }]} />
      <p class="eyebrow" data-work-render="ssr">Work</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-navy-900 sm:text-5xl">
        Selected work
      </h1>
      <p class="lead mt-4 max-w-2xl">
        Portfolio concepts and verified client work. We do not invent metrics, logos, or testimonials.
      </p>

      {
        projects.length === 0 ? (
          <div class="mt-10 max-w-2xl rounded-[var(--radius-lg)] border border-border bg-surface-muted p-6">
            <h2 class="font-display text-2xl font-bold text-navy-900">Case studies coming after owner approval</h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              This page intentionally has no sample portfolio items yet. When verified projects are added in
              <code class="rounded bg-white px-1.5 py-0.5 text-xs">src/config/site.ts</code>, they will appear here automatically.
            </p>
            <ul class="mt-5 list-disc space-y-2 pl-5 text-sm text-ink-muted">
              <li>Mobile-first conversion design</li>
              <li>SEO-ready information architecture</li>
              <li>Clear calls to action and contact paths</li>
              <li>Performance-minded WordPress delivery</li>
            </ul>
            <a href="/contact" class="btn-primary mt-6 inline-flex">Discuss your project</a>
          </div>
        ) : (
          <div class="mt-10 grid gap-5 md:grid-cols-2">
            {projects.map((project) => (
              <article class="surface-card overflow-hidden p-0">
                {project.imageSrc && (
                  <img
                    src={project.imageSrc}
                    alt={project.imageAlt ?? `${project.title} project preview`}
                    class="aspect-[3/2] h-auto w-full object-cover object-center"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="p-6">
                  <h2 class="font-display text-2xl font-bold text-navy-900">{project.title}</h2>
                  <p class="mt-3 text-sm text-ink-muted">{project.summary}</p>

                  {project.industry && (
                    <div class="mt-5">
                      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-navy-800">
                        Client Industry
                      </p>
                      <p class="mt-1 text-sm font-medium text-blue-500">{project.industry}</p>
                      {project.industryDetail && (
                        <p class="mt-2 text-sm text-ink-muted">{project.industryDetail}</p>
                      )}
                    </div>
                  )}

                  {project.websiteGoal && (
                    <div class="mt-5">
                      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-navy-800">
                        Project Goal
                      </p>
                      <p class="mt-2 text-sm text-ink-muted">{project.websiteGoal}</p>
                    </div>
                  )}

                  {(project.roles?.length || project.role) && (
                    <div class="mt-5">
                      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-navy-800">
                        My Role
                      </p>
                      {project.roles && project.roles.length > 0 ? (
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-ink-muted">
                          {project.roles.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      ) : (
                        <p class="mt-2 text-sm text-ink-muted">{project.role}</p>
                      )}
                    </div>
                  )}

                  {project.technologies && project.technologies.length > 0 && (
                    <div class="mt-5">
                      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-navy-800">
                        Technologies Used
                      </p>
                      <ul class="mt-3 flex flex-wrap gap-2">
                        {project.technologies.map((tech) => (
                          <li class="rounded-full border border-border px-3 py-1 text-xs text-ink-muted">
                            {tech}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {(project.conversionFocus || project.seoImplementation) && (
                    <div class="mt-5">
                      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-navy-800">
                        Conversion &amp; SEO
                      </p>
                      {project.conversionFocus && (
                        <p class="mt-2 text-sm text-ink-muted">{project.conversionFocus}</p>
                      )}
                      {project.seoImplementation && (
                        <p class="mt-2 text-sm text-ink-muted">{project.seoImplementation}</p>
                      )}
                    </div>
                  )}

                  {project.note && (
                    <p class="mt-5 rounded-[var(--radius-md)] border border-border bg-surface-muted p-3 text-xs leading-relaxed text-ink-muted">
                      {project.note}
                    </p>
                  )}

                  {project.services.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-2">
                      {project.services.map((service) => (
                        <li class="rounded-full bg-surface-muted px-3 py-1 text-xs font-medium text-navy-800">
                          {service}
                        </li>
                      ))}
                    </ul>
                  )}

                  {project.results && project.results.length > 0 && (
                    <ul class="mt-4 space-y-1 text-sm text-navy-800">
                      {project.results.map((r) => (
                        <li>
                          <strong>{r.value}</strong> — {r.label}
                        </li>
                      ))}
                    </ul>
                  )}

                  {project.href && (
                    <a
                      href={project.href}
                      class="btn-primary mt-5 inline-flex"
                      {...(isExternalProjectHref(project.href)
                        ? { target: '_blank', rel: 'noopener noreferrer' }
                        : {})}
                    >
                      {project.hrefLabel ??
                        (isExternalProjectHref(project.href) ? 'View live demo' : 'View project')}
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
  <FinalCta />
</BaseLayout>
