{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "name": "che-xu-studio",

  // IMPORTANT:
  // Do not use "@astrojs/cloudflare/entrypoints/server" here.
  // Wrangler resolves `main` as a filesystem path, so that package-export
  // string fails with: entry-point file ... was not found.
  //
  // Use the concrete package file for local/CI config validation.
  // Production deploys must still run `astro build` first, then deploy the
  // generated Worker via: npm run deploy
  // (uses dist/server/wrangler.json + dist/server/entry.mjs).
  "main": "./node_modules/@astrojs/cloudflare/dist/entrypoints/server.js",

  "observability": {
    "enabled": true
  },

  // D1 database for consented leads and verified order records.
  // Create with: wrangler d1 create che-xu-studio-db
  // Then replace database_id below with the returned ID.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "che-xu-studio-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI binding for the chat assistant.
  // `remote: true` means local preview talks to Cloudflare AI (may incur usage).
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // Rate limiting bindings for sensitive API endpoints.
  // Namespace IDs are account-local integers; adjust limits as needed.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]

  // Secrets / vars (set via `wrangler secret put` or `.dev.vars` locally):
  // TURNSTILE_SECRET_KEY
  // STRIPE_SECRET_KEY
  // STRIPE_WEBHOOK_SECRET
  // STRIPE_PRICE_*
  // PUBLIC_TURNSTILE_SITE_KEY
  // PUBLIC_SITE_URL
  // AI_MODEL
  // PUBLIC_CF_WEB_ANALYTICS_TOKEN
}
