{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Must match the Cloudflare Workers service connected to this repo.
  "name": "che-xu-studio-site",

  // Do NOT set:
  //   "main": "@astrojs/cloudflare/entrypoints/server"
  // Wrangler on Workers Builds treats that package export as a filesystem path and fails.
  //
  // Leave `main` / `assets` unset here so `astro build` can generate them.
  // `npm run build` runs scripts/prepare-cf-deploy.mjs afterward, which writes a
  // gitignored root wrangler.json pointing at dist/server/entry.mjs for deploy.

  "observability": {
    "enabled": true
  },

  // D1 database for consented leads and verified order records.
  // Optional for marketing-site deploys: prepare-cf-deploy.mjs omits this binding while
  // database_id is still the placeholder (Cloudflare rejects the placeholder UUID).
  // Create + write with: npm run db:create && npm run db:migrate:remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "che-xu-studio-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI binding for the chat assistant.
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // Rate limiting bindings for sensitive API endpoints.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
