{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Must match the Cloudflare Workers service connected to this repo.
  "name": "che-xu-studio-site",

  // Do NOT set:
  //   "main": "@astrojs/cloudflare/entrypoints/server"
  // Wrangler on Workers Builds treats that package export as a filesystem path and fails.
  //
  // Leave `main` / `assets` unset here so `astro build` can generate them.
  // `npm run build` runs scripts/prepare-cf-deploy.mjs afterward, which writes a
  // gitignored root wrangler.json pointing at dist/server/entry.mjs for deploy.

  // Keep dashboard Variables across deploys. Secrets should persist separately;
  // cf-deploy also re-uploads Builds secrets via --secrets-file.
  "keep_vars": true,

  "observability": {
    "enabled": true
  },

  // D1 database for consented leads and verified order records.
  // Create + migrate with: npm run db:create && npm run db:migrate:remote
  // (db:create is only needed when database_id is still a placeholder.)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "che-xu-studio-db",
      "database_id": "f1b23218-de32-4d82-a20d-29fa2f0b2eda",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI binding for the chat assistant.
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // Hourly: process email outbox retries + due-date reminder scan (business TZ in settings).
  // Cron is UTC; reminder eligibility uses settings.business_timezone (default America/Toronto).
  "triggers": {
    "crons": ["15 * * * *"]
  },

  // Cloudflare Browser Rendering — HTML → PDF for Proposal/Invoice/Receipt documents.
  "browser": {
    "binding": "BROWSER"
  },

  // Rate limiting bindings for sensitive API endpoints.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "CAPABILITY_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
